    """把桌面版登录恢复到某次备份。每次换号、保存登录之前都会自动备份到 ~/.cduo/backup/。"""
    bks = list_desktop_backups()
    if not args.name:
        if not bks:
            print("还没有桌面版登录备份（每次换号前会自动备份）")
            return
        print("桌面版登录备份（越往下越新）：")
        for p in bks:
            try:
                uid = (read_json(p / "config.json", {}) or {}).get("lastKnownAccountUuid")
            except RuntimeError:
                uid = None
            who = next((lbl(cfg, a["name"]) for a in cfg["accounts"] if uid and a.get("account_uuid") == uid), None)
            print(f"  {p.name}   {who or (uid[:8] + '…' if uid else '未登录')}")
        print("\n恢复：cduo restore <上面的名字>，或 cduo restore latest（最近一次换号前的登录）")
        return
    if args.name == "latest":
        cands = [p for p in bks if not p.name[16:].startswith("before-restore")]
        src = cands[-1] if cands else None
    elif re.match(r"^\d{8}-\d{6}-[\w.-]+$", args.name):
        src = BACKUP / args.name
    else:
        src = None
    if not src or not (src / "config.json").exists():
        die(f"找不到备份 {args.name}（运行 cduo restore 看看有哪些）")
    if (in_desktop_app() or under_claude_process()) and not args.detached:
        spawn_detached(["restore", src.name, "--detached"])
        print(f"好的：这一轮回复结束后 Claude 会重启，恢复到 {src.name} 时的登录。")
        return
    if args.detached:
        wait_idle(cfg)

    def run():
        cur = current_desktop_profile(cfg, load_state())
        if cur:   # 先把当前号最新的登录存好（桌面版会轮换 token），以后还能切回来
            try:
                save_profile(cur)
            except Exception as e:
                log(f"restore: could not save current profile {cur}: {e}")
        restore_desktop_backup(src)

        def fix(st):
            dc = current_desktop_profile(cfg, st)
            if dc:
                st["desktop_current"] = dc
            else:
                st.pop("desktop_current", None)
            st["switching"] = None
        update_state(fix)

    _with_app_closed(cfg, run, "before-restore")
    log(f"restored desktop backup {src.name}")
    print(f"{C['g']}✓ 已恢复到 {src.name} 时的桌面版登录{C['r']}（备份里的登录如果已经过期，Claude 会请你重新登录）")
    notify(f"已恢复到 {src.name} 时的登录")


