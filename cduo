def load_config() -> dict:
    cfg = read_json(CONFIG, None)
    if cfg is None:
        cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    for k, v in DEFAULT_CONFIG.items():
        cfg.setdefault(k, json.loads(json.dumps(v)))
    return cfg


def save_config(cfg: dict) -> None:
    write_json(CONFIG, cfg)


def load_state() -> dict:
    st = read_json(STATE, None) or {}
    st.setdefault("accounts", {})
    return st


def save_state(st: dict) -> None:
    st["updated"] = now()
    write_json(STATE, st)


def update_state(fn) -> dict:
    """加锁 → 重新读 → 改 → 写回。

    后台调度、菜单栏、换号进程会同时写 state.json。每个进程都只在锁里改自己负责的字段，
    就不会拿几分钟前读到的旧数据，把别人刚写进去的内容（比如 last_switch）整份冲掉。
    fn 里不能再调用 update_state（同一把锁不能重入）。
    """
    with file_lock("state"):
        st = load_state()
        fn(st)
        save_state(st)
        return st


def get_account(cfg: dict, name: str) -> dict:
    for a in cfg["accounts"]:
        if a["name"] == name:
            return a
    names = ", ".join(a["name"] for a in cfg["accounts"]) or "（还没有账号）"
    die(f"没有叫 {name} 的账号。现有：{names}")


def profile_dir(name: str) -> pathlib.Path:
    d = PROFILES / name
    old = PROFILES / f".{name}.old"
    if not d.exists() and old.exists():   # 上次换快照时正好被打断：把旧快照放回来
        with contextlib.suppress(OSError):
            os.replace(old, d)
    return d


def has_profile(name: str) -> bool:
    return (profile_dir(name) / "oauth.json").exists()


