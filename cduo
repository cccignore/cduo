    p.add_argument("key", nargs="?")
    p.add_argument("value", nargs="?")
    sub.add_parser("pin-org", help="记住并固定桌面版的主组织（如 Premium Seat）")
    p = sub.add_parser("rename", help="改账号的显示名（菜单栏/通知里显示）")
    p.add_argument("name")
    p.add_argument("label")
    p = sub.add_parser("agents", help="后台调度和菜单栏：install / uninstall / status / login-on / login-off")
    p.add_argument("action", choices=["install", "uninstall", "status", "login-on", "login-off"])
    p.add_argument("--no-menubar", action="store_true")
    sub.add_parser("doctor", help="自检")
    p = sub.add_parser("resume", help="续上被额度打断的任务：resume last（测试）/ next / check ID")
    p.add_argument("action", nargs="?", default="queue")
    p.add_argument("session", nargs="?")
    p.add_argument("--kind", choices=["switch", "reset", "test"])
    p.add_argument("--delay", default="5")
    args = ap.parse_args()
    if args.cmd == "resume" and args.action not in ("next", "check", "defer", "manual", "fail", "queue"):
        args.session, args.action = args.action, "queue"
    cfg = load_config()
    if not cfg.get("claude_bin") or not pathlib.Path(cfg["claude_bin"]).exists():
        cfg["claude_bin"] = find_claude_bin()
        if cfg["claude_bin"] and CONFIG.exists():
            save_config(cfg)
    cmds = {"status": cmd_status, "switch": cmd_switch, "setup": cmd_setup, "add": cmd_add, "login": cmd_login,
            "capture": cmd_capture, "desktop-login": cmd_desktop_login, "ping": cmd_ping, "sync": cmd_sync,
            "tick": cmd_tick, "config": cmd_config, "agents": cmd_agents, "doctor": cmd_doctor,
            "rename": cmd_rename, "pin-org": cmd_pin_org, "resume": cmd_resume}
    if not args.cmd:
        args = ap.parse_args(["status"])
    try:
        cmds[args.cmd](args, cfg)
    except KeyboardInterrupt:
        print("\n已取消")
        sys.exit(130)


