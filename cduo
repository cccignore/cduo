# ── launchd ──

AGENT_TICK = "com.cduo.tick"
AGENT_MENU = "com.cduo.menubar"


def agent_path(label: str) -> pathlib.Path:
    return HOME / "Library/LaunchAgents" / f"{label}.plist"


def menubar_exe() -> pathlib.Path:
    for base in ("/Applications", str(HOME / "Applications")):
        p = pathlib.Path(base) / "Cduo.app/Contents/MacOS/Cduo"
        if p.exists():
            return p
    return CDUO / "app" / "cduo-menubar"


def login_item_enabled() -> bool:
    out = subprocess.run(["launchctl", "print-disabled", f"gui/{os.getuid()}"], capture_output=True, text=True).stdout
    m = re.search(r'"%s"\s*=>\s*(\w+)' % re.escape(AGENT_MENU), out)
    if m and m.group(1) in ("disabled", "true"):
        return False
    return agent_path(AGENT_MENU).exists()


def install_agents(menubar: bool = True) -> None:
    LOGDIR.mkdir(parents=True, exist_ok=True)
    me = str(CDUO / "app" / "cduo")
    if not os.path.exists(me):
        me = os.path.abspath(__file__)
    uid = os.getuid()
    plists = {AGENT_TICK: {
        "Label": AGENT_TICK, "ProgramArguments": ["/usr/bin/python3", me, "tick"],
        "StartInterval": 300, "RunAtLoad": True, "ProcessType": "Background",
        "StandardOutPath": str(LOGDIR / "tick.out"), "StandardErrorPath": str(LOGDIR / "tick.out"),
        "EnvironmentVariables": {"PATH": "/usr/bin:/bin:/usr/sbin:/sbin"}}}
    mb = menubar_exe()
    if menubar and mb.exists():
        plists[AGENT_MENU] = {
            "Label": AGENT_MENU, "ProgramArguments": [str(mb)], "RunAtLoad": True,
            "KeepAlive": {"SuccessfulExit": False}, "ProcessType": "Interactive",
            "StandardOutPath": str(LOGDIR / "menubar.out"), "StandardErrorPath": str(LOGDIR / "menubar.out"),
            "EnvironmentVariables": {"PATH": "/usr/bin:/bin:/usr/sbin:/sbin", "CDUO_BIN": me}}
    for label, pl in plists.items():
        p = agent_path(label)
        p.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["launchctl", "bootout", f"gui/{uid}/{label}"], capture_output=True)
        with open(p, "wb") as f:
            plistlib.dump(pl, f)
        subprocess.run(["launchctl", "enable", f"gui/{uid}/{label}"], capture_output=True)
        r = subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(p)], capture_output=True, text=True)
        print(("✓ 已启用 " if r.returncode == 0 else "✗ 启用失败 ") + label + ("" if r.returncode == 0 else " " + r.stderr.strip()))


def uninstall_agents() -> None:
    uid = os.getuid()
    for label in (AGENT_TICK, AGENT_MENU):
        subprocess.run(["launchctl", "bootout", f"gui/{uid}/{label}"], capture_output=True)
        with contextlib.suppress(FileNotFoundError):
            agent_path(label).unlink()
        print(f"✓ 已移除 {label}")


def cmd_agents(args, cfg):
    if args.action in ("login-on", "login-off"):
        on = args.action == "login-on"
        subprocess.run(["launchctl", "enable" if on else "disable", f"gui/{os.getuid()}/{AGENT_MENU}"], capture_output=True)
        print("✓ 开机自动启动菜单栏：" + ("开" if on else "关"))
        return
    if args.action == "install":
        install_agents(menubar=not args.no_menubar)
    elif args.action == "uninstall":
        uninstall_agents()
    else:
        for label in (AGENT_TICK, AGENT_MENU):
            r = subprocess.run(["launchctl", "print", f"gui/{os.getuid()}/{label}"], capture_output=True, text=True)
            if r.returncode:
                desc = "未安装"
            elif label == AGENT_TICK:
                runs = re.search(r"runs = (\d+)", r.stdout)
                desc = f"已安装，每 5 分钟跑一次（已运行 {runs.group(1) if runs else '?'} 次）"
            else:
                desc = "运行中" if re.search(r"state = running", r.stdout) else "已安装但未运行"
            print(f"{label}: {desc}")


