def get_account(cfg: dict, name: str) -> dict:
    for a in cfg["accounts"]:
        if a["name"] == name:
            return a
    names = ", ".join(a["name"] for a in cfg["accounts"]) or "（还没有账号）"
    die(f"没有叫 {name} 的账号。现有：{names}")


