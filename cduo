def _setup_add_account(cfg: dict) -> dict:
    """设置向导里加一个号：起名 → 在浏览器里给 CLI 授权（查额度、预热用）。"""
    print(f"{C['b']}— 第 {len(cfg['accounts']) + 1} 个账号 —{C['r']}")
    while True:   # 名字不合规或重名就重问，别让整个向导直接退出
        name = ask("给它起个短名字（字母/数字，如 neu、me）")
        if not re.match(r"^[A-Za-z0-9_-]{1,16}$", name):
            print("名字只能用字母、数字、- 和 _，最长 16 个字符。")
        elif any(a["name"] == name for a in cfg["accounts"]):
            print(f"已经有一个叫 {name} 的号了，换个名字。")
        else:
            break
    label = ask("备注（可选）", name)
    reuse = ask("要复用已有的 Claude Code 配置目录吗？直接回车=新建专用目录（推荐）", "")
    cmd_add(argparse.Namespace(name=name, label=label, cli_dir=reuse or None), cfg)
    a = get_account(cfg, name)
    if not read_creds(a["cli_dir"])[0]:
        while not cli_login(cfg, a):
            if ask("重试登录？(y/n)", "y") != "y":
                break
    twin = next((x for x in cfg["accounts"] if x is not a and x.get("account_uuid")
                 and x.get("account_uuid") == a.get("account_uuid") and x.get("org_uuid") == a.get("org_uuid")), None)
    if twin:
        print(f"{C['y']}! 这个号和【{twin['name']}】是同一个账号、同一个组织，额度是共用的，加两次没有用。"
              f"可以用 cduo remove {name} 去掉它。{C['r']}")
    print()
    return a


def cmd_setup(args, cfg):
    want_add = bool(getattr(args, "add", False))
    adding = want_add and len(cfg["accounts"]) >= 2      # 已经设置过：只再加一个号，不再问作息时间
    need_real_terminal(["setup"] + (["--add"] if want_add else []), "设置")
    print(f"{C['b']}cduo：再加一个号{C['r']}（随时 Ctrl-C 退出）\n" if adding else
          f"{C['b']}cduo 设置向导{C['r']}（随时 Ctrl-C 退出，重新运行会接着来）\n")
    if not cfg.get("claude_bin"):
        cfg["claude_bin"] = find_claude_bin()
    print(f"claude 命令: {cfg.get('claude_bin') or '没找到'}")
    if not cfg.get("claude_bin"):
        cfg["claude_bin"] = ask("请输入 claude 可执行文件的完整路径")
    print(f"代理: {proxy_url(cfg) or '不使用'}（跟随系统设置）\n")
    if not adding:
        def norm(t):
            t = t.replace("：", ":").strip()
            if ":" not in t:
                t += ":00"
            hh, mm = map(int, t.split(":"))
            return f"{hh % 24:02d}:{mm:02d}"
        wh = cfg.get("work_hours") or {}
        ws = norm(ask("你一般几点开始用 Claude？(HH:MM)", wh.get("start", "10:00")))
        we = norm(ask("一般几点收工？(HH:MM)", wh.get("end", "01:00")))
        h, m = map(int, ws.split(":"))
        start = f"{(h - 4) % 24:02d}:{m:02d}"
        cfg["active_hours"] = {"start": start, "end": we}
        cfg["work_hours"] = {"start": ws, "end": we}
        print(f"→ 自动预热时段设为 {start}–{we}（开工前约 4 小时预热第一个号，开工后约 1 小时就会有一次额度刷新）\n")
    save_config(cfg)

    while len(cfg["accounts"]) < 2:      # 至少两个号
        _setup_add_account(cfg)
    if adding:
        _setup_add_account(cfg)
    else:
        while ask(f"现在有 {len(cfg['accounts'])} 个号。还要再加一个吗？号越多，刷新时间错得越密 (y/n)",
                  "n").strip().lower() == "y":
            _setup_add_account(cfg)

    st = load_state()
    for a in cfg["accounts"]:
        if has_profile(a["name"]):
            continue
        desktop_login_flow(cfg, a, st)

    print()
    gap = dur(WINDOW / max(1, len(prewarm_accounts(cfg))))
    if adding and agent_path(AGENT_TICK).exists():
        print(f"后台调度已经在跑，新加的号 5 分钟内就会算进去（{accounts_text(len(cfg['accounts']))}按 {gap} 错峰）。")
    elif ask(f"安装后台调度（每 5 分钟查额度、{accounts_text(len(cfg['accounts']))}按 {gap} 错峰自动预热）和菜单栏？(y/n)",
             "y") == "y":
        install_agents()
    print(f"\n{C['g']}全部完成！{C['r']} 常用命令：cduo（看状态） · cduo switch（切号） · cduo doctor（自检）")
    cmd_status(argparse.Namespace(json=False, cached=False), cfg)


# ── SSO 登录：桌面版用系统默认浏览器打开 SSO 登录页（ASWebAuth） ──
# 默认浏览器里如果还登录着另一个同校/同组织的账号，SSO 会直接用那个账号放行，Claude 就登录成了那个号。

SETTINGS_DEFAULT_BROWSER = "x-apple.systempreferences:com.apple.Desktop-Settings.extension"


def default_browser_path() -> str | None:
    """系统默认网页浏览器的 .app 路径（读不到返回 None）。"""
    js = ('ObjC.import("AppKit");'
          'var u=$.NSWorkspace.sharedWorkspace.URLForApplicationToOpenURL($.NSURL.URLWithString("https://claude.ai"));'
          'u.isNil()?"":u.path.js')
    try:
        p = subprocess.run(["osascript", "-l", "JavaScript", "-e", js],
                           capture_output=True, text=True, timeout=10).stdout.strip()
    except Exception:
        return None
    return p or None


def default_browser_name() -> str | None:
    p = default_browser_path()
    return pathlib.Path(p).stem if p else None


def sso_peers(cfg: dict, a: dict) -> list:
    """和 a 同邮箱域名或同组织（多半走同一个 SSO）的其他账号名。"""
    dom = (a.get("email") or "").rpartition("@")[2].lower()
    out = []
    for x in cfg["accounts"]:
        if x["name"] == a["name"]:
            continue
        xd = (x.get("email") or "").rpartition("@")[2].lower()
        if (dom and xd == dom) or (a.get("org_uuid") and x.get("org_uuid") == a.get("org_uuid")):
            out.append(x["name"])
    return out


def sso_browser_check(cfg: dict, a: dict) -> str | None:
    """登录前提醒默认浏览器的事，并可打开设置让用户换。返回原来的默认浏览器名（用来登录后提醒换回去）。"""
    peers = sso_peers(cfg, a)
    if not peers:
        return None
    name0 = default_browser_name()
    shown = name0 or "默认浏览器"
    others = "、".join(lbl(cfg, n) for n in peers)
    print(f"\n{C['y']}注意：{C['r']}Claude 会用默认浏览器（{shown}）打开 SSO 登录页。"
          f"如果 {shown} 里还登录着【{others}】的账号，SSO 会直接放行，Claude 就会登录成那个号。")
    print(f"办法：临时把默认浏览器换成没登录过这些账号的浏览器（一般是 Safari），登录完再换回来；"
          f"或者先在 {shown} 里退出那个账号。")
    if ask("现在打开「默认网页浏览器」设置？(y/n)", "y") == "y":
        subprocess.run(["open", SETTINGS_DEFAULT_BROWSER], capture_output=True)
        input("在「桌面与程序坞 → 默认网页浏览器」里换好后按回车 …")
        name1 = default_browser_name()
        if name1 and name1 == name0:
            print(f"默认浏览器还是 {name1}。如果已经在 {name1} 里退出了那个账号，可以直接继续。")
        elif name1:
            print(f"默认浏览器现在是 {name1}。")
    return name0


def desktop_login_flow(cfg: dict, a: dict, st: dict) -> None:
    """让桌面版登录某个号并保存快照（之后就能一键切换到它）。"""
    uid = desktop_account_uuid()
    if uid and uid == a.get("account_uuid"):
        print(f"检测到桌面版当前登录的就是【{a['name']}】，保存它的登录（Claude 会重启一下）…")
        cmd_capture(argparse.Namespace(name=a["name"], force=False, detached=False), cfg)
        return
    print(f"\n接下来在桌面版登录【{a['name']}】（{a.get('email') or '它的账号'}）。")
    browser0 = sso_browser_check(cfg, a)
    cur = current_desktop_profile(cfg, st)
    if uid and not cur:
        print("桌面版当前登录的账号不属于 Cduo 管理的号。")
        if ask("把桌面版当前登录先备份起来再继续？(y/n)", "y") != "y":
            die("已取消")
        backup_desktop("foreign-login")
    input("按回车：Claude 会以未登录状态重新打开 …")
    cmd_desktop_login(argparse.Namespace(name=a["name"]), cfg) if (cur or not uid) else _foreign_login_reset(cfg)
    while True:
        input(f"在 Claude 里登录好【{a['name']}】后按回车 …")
        uid2 = desktop_account_uuid()
        if uid2 and (not a.get("account_uuid") or uid2 == a["account_uuid"]):
            break
        if uid2 and a.get("account_uuid") and uid2 != a["account_uuid"]:
            other = next((x["name"] for x in cfg["accounts"] if x.get("account_uuid") == uid2), None)
            print(f"Claude 里登录的不是【{a['name']}】（{a.get('email')}）"
                  + (f"，而是【{lbl(cfg, other)}】" if other else "") + "。")
            if other and other in sso_peers(cfg, a):
                print(f"多半是默认浏览器（{default_browser_name() or '?'}）里还登录着【{lbl(cfg, other)}】的 SSO 账号。"
                      f"换个默认浏览器，或在浏览器里退出那个账号后再试。")
            # 登进来的号已经有快照，丢掉这次登录没有损失，可以直接重来
            if other and has_profile(other) and ask("让 Claude 再以未登录状态打开一次？(y/n)", "y") == "y":
                _foreign_login_reset(cfg)
                continue
            print("请在 Claude 里换成这个账号再按回车。")
        else:
            print("还没检测到这个账号的登录（如果刚登录，等几秒再按回车）。")
    cmd_capture(argparse.Namespace(name=a["name"], force=False, detached=False), cfg)
    now_browser = default_browser_name()
    if browser0 and now_browser and now_browser != browser0:
        print(f"\n{C['y']}登录已保存，可以把默认浏览器换回 {browser0} 了。{C['r']}")
        if ask("现在打开「默认网页浏览器」设置？(y/n)", "y") == "y":
            subprocess.run(["open", SETTINGS_DEFAULT_BROWSER], capture_output=True)


def cmd_login_desktop(args, cfg):
    """只补"在桌面版登录这个号"这一步（setup 没走完、或登录过期时用）。"""
    need_real_terminal(["login-desktop", args.name], "在桌面版登录")
