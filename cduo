def desktop_config_path() -> pathlib.Path:
    return APP_SUPPORT / "config.json"


def desktop_account_uuid():
    return (read_json(desktop_config_path(), {}) or {}).get("lastKnownAccountUuid")


def desktop_org_hint():
    """桌面版最近一次上报用量时所在的组织（plan-usage-history.json）。"""
    h = read_json(APP_SUPPORT / "plan-usage-history.json", {}) or {}
    s = h.get("samples") or []
    if not s:
        return None
    last = max(s, key=lambda x: x.get("t", 0))
    return {"org": last.get("org"), "t": last.get("t", 0) / 1000}


def current_desktop_profile(cfg: dict, st: dict):
    uid = desktop_account_uuid()
    if not uid:
        return None
    matches = [a["name"] for a in cfg["accounts"] if a.get("account_uuid") == uid]
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        org = desktop_org_hint()
        by_org = [a["name"] for a in cfg["accounts"] if a.get("account_uuid") == uid and a.get("org_uuid") == org]
        if len(by_org) == 1:
            return by_org[0]
        if st.get("desktop_current") in matches:
            return st["desktop_current"]
        return matches[0]
    return None


def save_profile(name: str, account_uuid_expected: str | None = None) -> None:
    """把桌面版当前登录存成快照。调用前 App 必须已退出。"""
    conf = read_json(desktop_config_path(), {}) or {}
    if not conf.get("oauth:tokenCacheV2") and not conf.get("oauth:tokenCache"):
        raise RuntimeError("桌面版当前没有登录")
    if account_uuid_expected and conf.get("lastKnownAccountUuid") != account_uuid_expected:
        raise RuntimeError("桌面版当前登录的账号和要保存的账号对不上")
    d = profile_dir(name)
    tmp, old = d.with_name(f".{name}.tmp"), d.with_name(f".{name}.old")
    shutil.rmtree(tmp, ignore_errors=True)
    tmp.mkdir(parents=True)
    os.chmod(tmp, 0o700)
    write_json(tmp / "oauth.json", {k: conf[k] for k in DESKTOP_KEYS if k in conf})
    for fn in COOKIE_FILES:
        src = APP_SUPPORT / fn
        if src.exists():
            shutil.copy2(src, tmp / fn)
            os.chmod(tmp / fn, 0o600)
    write_json(tmp / "meta.json", {"saved_at": now(), "account_uuid": conf.get("lastKnownAccountUuid")})
    # 新快照完整写好之后再整个换上去：中途出错，旧快照原封不动
    shutil.rmtree(old, ignore_errors=True)
    if d.exists():
        os.replace(d, old)
    os.replace(tmp, d)
    shutil.rmtree(old, ignore_errors=True)


# ── 固定组织：Claude 用 lastActiveOrg cookie 记住上次的组织 ──
# cookie 是加密的，但同一台机器上"同一个组织"的密文完全相同（固定 IV），
# 所以只要从一份"正处于该组织"的登录里记下密文，就能写进任何账号的 Cookies。

ORG_COOKIES = CDUO / "org-cookies.json"


def _org_cookie_row(db: pathlib.Path):
    import sqlite3
    tmp = CDUO / f".cookies-read.{os.getpid()}"
    shutil.copy2(db, tmp)
    try:
        con = sqlite3.connect(str(tmp))
        con.row_factory = sqlite3.Row
        r = con.execute("select * from cookies where host_key='.claude.ai' and name='lastActiveOrg'").fetchone()
        con.close()
        if not r:
            return None
        d = dict(r)
        d["encrypted_value"] = bytes(d["encrypted_value"]).hex()
        return d
    finally:
        tmp.unlink(missing_ok=True)


def current_desktop_org():
    """桌面版当前所在组织：在桌面版会话里运行时直接读环境变量；否则看哪个组织文件夹最近有会话活动。"""
    if in_desktop_app() and os.environ.get("CLAUDE_CODE_ORGANIZATION_UUID"):
        return os.environ["CLAUDE_CODE_ORGANIZATION_UUID"]
    uid = desktop_account_uuid()
    if not uid or not (SESSIONS_ROOT / uid).is_dir():
        return None
    best, best_t = None, 0.0
    for d in (SESSIONS_ROOT / uid).iterdir():
        if not d.is_dir():
            continue
        for p in d.glob("local_*.json"):
            t = p.stat().st_mtime
            if t > best_t:
                best, best_t = d.name, t
    return best if now() - best_t < 3600 else None


def learn_org_cookie(org_uuid: str) -> bool:
    row = _org_cookie_row(APP_SUPPORT / "Cookies")
    if not row:
        return False
    # macOS 上 Chromium 的 cookie 密文以 "v10" 开头。不是这个格式，说明加密方式变了，不能照搬到别的登录里
    if not row["encrypted_value"].startswith(("763130", "763131")):
        log(f"org cookie for {org_uuid[:8]} uses an unknown encryption format; not learning it")
        return False
    m = read_json(ORG_COOKIES, {}) or {}
    for k, v in list(m.items()):   # 同一段密文不能对应两个组织
        if k != org_uuid and v.get("encrypted_value") == row["encrypted_value"]:
            del m[k]
    m[org_uuid] = row
    write_json(ORG_COOKIES, m)
    return True


def apply_org_cookie(db: pathlib.Path, org_uuid: str) -> bool:
    """把 db（App 已退出时的 Cookies 文件）里的 lastActiveOrg 设成 org_uuid。"""
    import sqlite3
    row = (read_json(ORG_COOKIES, {}) or {}).get(org_uuid)
    if not row or not db.exists():
        return False
    blob = bytes.fromhex(row["encrypted_value"])
    row = dict({"host_key": ".claude.ai", "name": "lastActiveOrg", "path": "/", "top_frame_site_key": ""}, **row)
    con = sqlite3.connect(str(db))
    try:
        cur = con.execute("update cookies set encrypted_value=?, value='' where host_key='.claude.ai' and name='lastActiveOrg'", (blob,))
        if cur.rowcount == 0:
            info = [(c[1], (c[2] or "").upper()) for c in con.execute("pragma table_info(cookies)")]
            cols = [c for c, _ in info]
            vals = [blob if c == "encrypted_value"
                    else (row.get(c) if row.get(c) is not None else (0 if "INT" in t else ("" if "TEXT" in t else b"")))
                    for c, t in info]
            con.execute(f"insert into cookies ({','.join(cols)}) values ({','.join('?' * len(cols))})", vals)
        con.commit()
    finally:
        con.close()
    return True


def pin_org_for(cfg: dict, name: str) -> None:
    a = next((x for x in cfg["accounts"] if x["name"] == name), None)
    if cfg.get("pin_org", True) and a and a.get("org_uuid"):
        try:
            if apply_org_cookie(APP_SUPPORT / "Cookies", a["org_uuid"]):
                log(f"pinned org {a['org_uuid'][:8]} for {name}")
        except Exception as e:   # 固定失败不影响换号
            log(f"pin org failed for {name}: {e}")


def restore_profile(name: str) -> None:
    d = profile_dir(name)
    snap = read_json(d / "oauth.json", None)
    if not snap:
        raise RuntimeError(f"{name} 没有桌面版登录快照，先运行 cduo capture {name}")
    if not any(snap.get(k) for k in TOKEN_KEYS):
        raise RuntimeError(f"{name} 的桌面版登录快照里没有登录信息，请在 Claude 里登录它后重新保存：cduo capture {name}")
    path = desktop_config_path()
    conf = read_json(path, {}) or {}
    for k in DESKTOP_KEYS:
        if k in snap:
            conf[k] = snap[k]
        else:
            conf.pop(k, None)
    write_json(path, conf, mode=0o644, indent=2)
    for fn in COOKIE_FILES:
        src, dst = d / fn, APP_SUPPORT / fn
        if src.exists():
            shutil.copy2(src, dst)
        elif dst.exists():
            dst.unlink()


def clear_desktop_login() -> None:
    path = desktop_config_path()
    conf = read_json(path, {}) or {}
    for k in DESKTOP_KEYS:
        conf.pop(k, None)
    write_json(path, conf, mode=0o644, indent=2)
    for fn in COOKIE_FILES:
        with contextlib.suppress(FileNotFoundError):
            (APP_SUPPORT / fn).unlink()


def backup_desktop(tag: str) -> pathlib.Path:
    stamp = f"{dt.datetime.now():%Y%m%d-%H%M%S}"
    dest, n = BACKUP / f"{stamp}-{tag}", 1
    while dest.exists():            # 同一秒里备份了两次：别把上一份覆盖掉
        n += 1
        dest = BACKUP / f"{stamp}-{tag}-{n}"
    dest.mkdir(parents=True)
    os.chmod(dest, 0o700)
    for fn in ("config.json",) + COOKIE_FILES:
        src = APP_SUPPORT / fn
        if src.exists():
            shutil.copy2(src, dest / fn)
    _prune_backups()
    return dest


def _prune_backups() -> None:
    """登录备份、会话列表备份各保留最近 BACKUP_KEEP 份。分开数，会话备份再多也不会把登录备份挤掉。"""
    if not BACKUP.is_dir():
        return
    dirs = sorted(p for p in BACKUP.iterdir() if p.is_dir() and re.match(r"\d{8}-\d{6}-", p.name))
    sessions = [p for p in dirs if p.name.endswith("-sessions")]
    logins = [p for p in dirs if not p.name.endswith("-sessions")]
    for group in (sessions, logins):
        for p in group[:-BACKUP_KEEP]:
            shutil.rmtree(p, ignore_errors=True)


def list_desktop_backups() -> list:
    """桌面版登录备份（旧的在前）。"""
    if not BACKUP.is_dir():
        return []
    return sorted(p for p in BACKUP.iterdir()
                  if p.is_dir() and not p.name.endswith("-sessions") and (p / "config.json").exists())


def restore_desktop_backup(src: pathlib.Path) -> None:
    """把一份备份放回桌面版目录（App 必须已退出）。备份里没有的文件要删掉，免得新旧 Cookies 混在一起。"""
    for fn in ("config.json",) + COOKIE_FILES:
        s, d = src / fn, APP_SUPPORT / fn
        if s.exists():
            tmp = d.with_name(f".{d.name}.cduo-restore")
            shutil.copy2(s, tmp)
            os.replace(tmp, d)
        else:
            with contextlib.suppress(FileNotFoundError):
                d.unlink()


# ── 兼容性检查：cduo 依赖桌面版没有公开的文件结构，动手前先确认还是认识的样子 ──

def desktop_app_version():
    for base in ("/Applications", str(HOME / "Applications")):
        p = pathlib.Path(base) / "Claude.app/Contents/Info.plist"
        try:
            return plistlib.loads(p.read_bytes()).get("CFBundleShortVersionString")
        except Exception:
            continue
    return None


def _cookie_columns(db: pathlib.Path):
    """Cookies 数据库 cookies 表的列名；读不了返回 None。读的是副本，不碰原文件。"""
    import sqlite3
    CDUO.mkdir(parents=True, exist_ok=True)
    tmp = CDUO / f".cookies-schema.{os.getpid()}"
    try:
        shutil.copy2(db, tmp)
        con = sqlite3.connect(str(tmp))
        try:
            return [r[1] for r in con.execute("pragma table_info(cookies)")]
        finally:
            con.close()
    except Exception:
        return None
    finally:
        tmp.unlink(missing_ok=True)


def desktop_compat_problems() -> list:
    """桌面版的登录文件还是不是 cduo 认识的样子。返回问题列表；空列表 = 可以放心动手。"""
    probs = []
    p = desktop_config_path()
    if p.exists():
        try:
            conf = read_json(p, {})
        except RuntimeError as e:
            return [f"读不了桌面版的 config.json（{e}）"]
        if not isinstance(conf, dict):
            return ["桌面版的 config.json 不是预期的格式"]
        if conf.get("lastKnownAccountUuid") and not any(conf.get(k) for k in TOKEN_KEYS):
            probs.append("config.json 里找不到登录信息（oauth:tokenCache）：桌面版可能已退出登录，"
                         "也可能是 Claude 更新后换了登录的存法")
    db = APP_SUPPORT / "Cookies"
    if db.exists():
        cols = _cookie_columns(db)
        if cols is None:
            probs.append("读不了桌面版的 Cookies 数据库")
        elif not {"host_key", "name", "encrypted_value"} <= set(cols):
            probs.append("桌面版 Cookies 数据库的表结构变了")
    return probs


# ───────────────────────── 桌面版：会话列表同步 ─────────────────────────

def _uuid_of(name: str) -> str:
    n = name
    for pre in ("deleted_", "local_"):
        if n.startswith(pre):
            n = n[len(pre):]
    return n[:-5] if n.endswith(".json") else n


def ensure_org_folders(cfg: dict | None = None) -> int:
    """给 cduo 管理的每个账号，在已知的每个组织下都预先建好会话文件夹。

    一个登录可能属于多个组织（如 Premium Seat + 另一个组织），桌面版按 账号/组织 分文件夹，
    在 App 里切组织时才会新建空文件夹。提前建好，切过去时会话列表就已经在了。
    """
    if not SESSIONS_ROOT.is_dir():
        return 0
    cfg = cfg or load_config()
    accts = {a["account_uuid"] for a in cfg["accounts"] if a.get("account_uuid")}
    orgs = {a["org_uuid"] for a in cfg["accounts"] if a.get("org_uuid")}
    for p in SESSIONS_ROOT.glob("*/*"):
        if p.is_dir() and re.match(r"^[0-9a-f-]{36}$", p.name):
            orgs.add(p.name)
    made = 0
    for a in accts:
        for o in orgs:
            d = SESSIONS_ROOT / a / o
            if not d.exists():
                d.mkdir(parents=True, mode=0o700)
                os.chmod(d.parent, 0o700)
                made += 1
    if made:
        log(f"created {made} org session folders")
    return made


def sync_sessions(dry: bool = False, verbose: bool = False, missing_only: bool = False) -> dict:
    """让每个 账号/组织 文件夹都拥有全部会话的侧边栏记录（只增不删，新的覆盖旧的）。

    missing_only=True 时只补缺、不改已有记录——App 运行中也可以安全地跑。
    """
    summary = {"folders": 0, "copied": 0, "updated": 0, "skipped_deleted": 0}
    if not SESSIONS_ROOT.is_dir():
        return summary
    if not dry:
        ensure_org_folders()
    folders = [p for p in SESSIONS_ROOT.glob("*/*") if p.is_dir() and not p.is_symlink()]
    summary["folders"] = len(folders)
    if len(folders) < 2:
        return summary
    deleted, entries = set(), {}
    for f in folders:
        for p in f.iterdir():
            if p.name.startswith("deleted_"):
                deleted.add(_uuid_of(p.name))
            elif p.name.startswith("local_") and p.name.endswith(".json"):
                try:
                    data = json.loads(p.read_text(encoding="utf-8"))
                except Exception:
                    continue
                key = (data.get("lastActivityAt") or 0, p.stat().st_mtime)
                entries.setdefault(_uuid_of(p.name), {})[f] = (p, data, key)
    bk = None
    written = {}  # folder -> {uid: isArchived}
    for uid, per in entries.items():
        datas = [d for (_, d, _) in per.values()]
        if uid in deleted or any(d.get("cliSessionId") in deleted for d in datas):
            summary["skipped_deleted"] += 1
            continue
        best_p, best, best_key = max(per.values(), key=lambda x: x[2])
        for f in folders:
            target = f / f"local_{uid}.json"
            if f not in per:
                summary["copied"] += 1
                if verbose:
                    print(f"  + {best.get('title') or uid}  →  {f.parent.name[:8]}/{f.name[:8]}")
                if not dry:
                    _write_pointer(target, best)
                    written.setdefault(f, {})[uid] = bool(best.get("isArchived"))
                continue
            p, cur, key = per[f]
            if not missing_only and key[0] < best_key[0] and cur != best:
                merged = dict(best)
                for k in PRESERVE_POINTER_KEYS:
                    if k in cur:
                        merged[k] = cur[k]
                summary["updated"] += 1
                if verbose:
                    print(f"  ↻ {best.get('title') or uid}  →  {f.parent.name[:8]}/{f.name[:8]}")
                if not dry:
                    if bk is None:
                        bk = BACKUP / f"{dt.datetime.now():%Y%m%d-%H%M%S}-sessions"
                    dst = bk / f.parent.name / f.name
                    dst.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(p, dst / p.name)
                    _write_pointer(target, merged)
                    written.setdefault(f, {})[uid] = bool(merged.get("isArchived"))
    for f, ws in written.items():  # 归档索引与会话里的 isArchived 保持一致
        idx_p = f / "archived-sessions.idx"
        idx = read_json(idx_p, None) or {"v": 1, "archived": []}
        arch = list(idx.get("archived") or [])
        for uid, is_arch in ws.items():
            sid = f"local_{uid}"
            if is_arch and sid not in arch:
                arch.append(sid)
            elif not is_arch and sid in arch:
                arch.remove(sid)
        if arch != (idx.get("archived") or []) or (arch and not idx_p.exists()):
            idx["archived"] = arch
            _write_pointer(idx_p, idx)
    if bk is not None:
        _prune_backups()
    if not dry and (summary["copied"] or summary["updated"]):
        log(f"sync_sessions {summary}")
    return summary


def _write_pointer(target: pathlib.Path, data: dict) -> None:
    tmp = target.with_name(f".{target.name}.cduo.tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False), encoding="utf-8")
    os.chmod(tmp, 0o600)
    os.replace(tmp, target)


# ───────────────────────── 调度：EDF 推荐 + 错峰预热 ─────────────────────────

def in_active_hours(cfg: dict, t: float | None = None) -> bool:
    ah = cfg.get("active_hours") or {}
    s, e = ah.get("start", "00:00"), ah.get("end", "24:00")
    d = dt.datetime.fromtimestamp(t or now())
    m = d.hour * 60 + d.minute
    tm = lambda x: int(x.split(":")[0]) * 60 + int(x.split(":")[1])
    a, b = tm(s), tm(e)
    if a == b:
        return True
    return a <= m < b if a < b else (m >= a or m < b)


def prewarm_accounts(cfg: dict) -> list:
    return [a for a in cfg["accounts"] if a.get("prewarm", True)]


def accounts_text(n: int) -> str:
    """说"全部账号"时用：两个号就说"两个号"，更多就说"3 个号"。"""
    return "两个号" if n == 2 else f"{n} 个号"


def lbl(cfg: dict, name) -> str:
    """显示名：优先用备注。"""
    if not name:
        return "?"
    a = next((x for x in cfg["accounts"] if x["name"] == name), None)
    return (a.get("label") or name) if a else name


def plan_pings(cfg: dict, st: dict):
    """返回 (要立刻预热的账号, 说明, 下一次预计预热时间)。

    规则：n 个账号的重置时刻在 5h 内均匀错开（2 个号=相隔 2.5h，3 个号=相隔 1h40m，以此类推）。
    - 都没在计时：先启动桌面版当前在用的那个；
    - 有在计时的：当最近启动的那个窗口已经跑了 5h/n，就启动下一个空闲账号。
    """
    accts = prewarm_accounts(cfg)
    if not accts:
        return None, "没有参与预热的账号", None
    n = len(accts)
    gap = WINDOW / n
    rs = {a["name"]: est_resets(st["accounts"].get(a["name"], {})) for a in accts}
    running = [a for a in accts if rs[a["name"]]]
    idle = [a for a in accts if not rs[a["name"]]]
    if not idle:
        return None, f"{accounts_text(n)}都在计时，刷新时间已错开", None
    cur = st.get("desktop_current")
    idle.sort(key=lambda a: (0 if a["name"] == cur else 1, accts.index(a)))
    first = lbl(cfg, idle[0]["name"])
    if not running:
        return idle[0], f"现在让 {first} 开始计时", now()
    latest = max(rs[a["name"]] for a in running)
    due = latest - (WINDOW - gap)
    if now() >= due:
        return idle[0], f"现在让 {first} 开始计时（与上一个号错开 {dur(gap)}）", due
    return None, f"{first} 将在 {hhmm(due)} 自动开始计时（错开 {dur(gap)}）", due


def recommend(cfg: dict, st: dict) -> dict:
    """用'最早过期优先'（EDF）决定桌面版该用哪个号，带防抖。"""
    thr = 99.5 if cfg.get("auto_switch") == "idle" else float(cfg.get("switch_threshold", 95))
    cur = st.get("desktop_current")
    cands = [a for a in cfg["accounts"] if has_profile(a["name"])]
    if not cands:
        return {"action": "none", "reason": "还没有桌面版登录快照"}
    info = {}
    for a in cands:
        u = st["accounts"].get(a["name"], {})
        eu = effective_util(u)
        info[a["name"]] = {"util": eu, "running": window_running(u), "resets": u.get("resets_at") if window_running(u) else None}
    usable = [n for n, i in info.items() if i["util"] is None or i["util"] < thr]
    if not usable:
        for a in cfg["accounts"]:          # 还有额度、只是没在桌面版登录过的号
            if has_profile(a["name"]):
                continue
            eu = effective_util(st["accounts"].get(a["name"], {}))
            if eu is not None and eu < thr:
                return {"action": "need_login", "target": a["name"], "urgent": True,
                        "reason": f"{lbl(cfg, a['name'])} 还有额度，但还没在桌面版登录过。"
                                  f"点它卡片上的「登录桌面版」，登录一次以后就能一键切换"}
        soon = min((i["resets"] for i in info.values() if i["resets"]), default=None)
        return {"action": "wait", "target": None,
                "reason": f"{accounts_text(len(cfg['accounts']))}都快用完了，{hhmm(soon)} 恢复"}
    rank = sorted(usable, key=lambda n: (0 if info[n]["running"] else 1, info[n]["resets"] or 9e12,
                                         0 if n == cur else 1))
    best = rank[0]
    if cur not in usable:
        why = (f"{lbl(cfg, cur)} 已用 {info[cur]['util']:.0f}%" if cur in info and info[cur]["util"] is not None
               else "当前号不可用")
        return {"action": "switch", "target": best, "urgent": True, "reason": why}
    if best != cur and info[best]["running"] and info[best]["util"] is not None:
        left = 100 - info[best]["util"]
        soon = info[best]["resets"] - now() <= 90 * 60
        cur_later = (not info[cur]["running"]) or (info[cur]["resets"] or 0) - info[best]["resets"] >= 30 * 60
        if soon and left >= 25 and cur_later:
            return {"action": "switch", "target": best, "urgent": False,
                    "reason": f"{lbl(cfg, best)} 还剩 {left:.0f}%，{hhmm(info[best]['resets'])} 刷新后就作废，先用它"}
    return {"action": "stay", "target": cur, "reason": "当前用的就是最合适的号"}


TICK_OWNED = ("desktop_org", "next_ping", "recommend", "interrupted", "resume_wait", "post_switch_warned")


def _save_tick_state(cfg: dict, st: dict, notified0) -> None:
    """把这一轮 tick 算出来的结果并进 state.json。

    tick 中间要联网（预热最长 3 分钟），这期间换号、续上排队可能已经写了 last_switch、switching、
    resume_handled 等字段。这里只写 tick 自己负责的字段，其余以文件里最新的为准。
    """
    def merge(cur: dict) -> None:
        for name, u in st["accounts"].items():
            old = cur["accounts"].get(name) or {}
            new = dict(old) if (old.get("fetched") or 0) > (u.get("fetched") or 0) else dict(u)
            if (old.get("last_ping") or 0) > (new.get("last_ping") or 0):
                new["last_ping"], new["last_ping_ok"] = old["last_ping"], old.get("last_ping_ok", True)
            cur["accounts"][name] = new
        for k in TICK_OWNED:
            if k in st:
                cur[k] = st[k]
            else:
                cur.pop(k, None)
        if cur.get("last_notified") == notified0:   # 期间没人动过才写（换号时会清空它，不能被冲回去）
            cur["last_notified"] = st.get("last_notified")
        dc = current_desktop_profile(cfg, cur)       # 以桌面版此刻的登录为准
        if dc:
            cur["desktop_current"] = dc
    update_state(merge)


def desktop_logged_in():
    """桌面版现在是否处于登录状态；没有或读不了 config.json 时返回 None（判断不了）。"""
    try:
        conf = read_json(desktop_config_path(), None)
    except RuntimeError:
        return None
    if not isinstance(conf, dict):
        return None
    return bool(conf.get("lastKnownAccountUuid")) and any(conf.get(k) for k in TOKEN_KEYS)


def check_after_switch(st: dict, app_up: bool) -> None:
    """换号后 1～30 分钟内，桌面版如果变成了未登录（比如 Claude 更新后不认快照了），提醒一次怎么恢复。"""
    ls = st.get("last_switch") or {}
    at = ls.get("at") or 0
    if not app_up or not (60 < now() - at < 30 * 60) or st.get("post_switch_warned") == at:
        return
    if desktop_logged_in() is False:
        notify("Claude 重启后是未登录状态。如果登录页一直不消失，运行 cduo restore latest 回到换号前的登录。",
               "换号可能没成功")
        log(f"post-switch check: desktop is logged out after switching to {ls.get('to')}")
        st["post_switch_warned"] = at


def tick(cfg: dict, verbose: bool = False, allow_ping: bool = True) -> dict:
    with file_lock("tick", blocking=False) as got:
        if not got:
            return load_state()
        rotate_logs()
        st = load_state()
        notified0 = st.get("last_notified")
        for a in cfg["accounts"]:
            prev = st["accounts"].get(a["name"], {})
            u = fetch_account_usage(cfg, a)
            u["last_ping"] = prev.get("last_ping")
            u["last_ping_ok"] = prev.get("last_ping_ok", True)
            st["accounts"][a["name"]] = u
        cur = current_desktop_profile(cfg, st)
        if cur:
            st["desktop_current"] = cur
        st["desktop_org"] = desktop_org_hint()
        try:   # 自动记住"主组织"的 cookie，用于换号时固定组织
            a_cur = next((x for x in cfg["accounts"] if x["name"] == cur), None) if cur else None
            if a_cur and a_cur.get("org_uuid") and a_cur["org_uuid"] not in (read_json(ORG_COOKIES, {}) or {}) \
                    and current_desktop_org() == a_cur["org_uuid"]:
                if learn_org_cookie(a_cur["org_uuid"]):
                    log(f"learned org cookie for {a_cur.get('org_name')}")
        except Exception as e:
            log(f"learn org cookie failed: {e}")
        try:   # 在 App 里新切了组织 → 5 分钟内把会话列表补过去
            sync_sessions(missing_only=True)
        except Exception as e:
            log(f"background sync failed: {e}")
        pinged = None
        acct, why, due = plan_pings(cfg, st)
        active = in_active_hours(cfg)
        enabled = cfg.get("prewarm_enabled", True)
        if allow_ping and active and acct and enabled:
            u0 = st["accounts"][acct["name"]]
            backoff = 15 * 60 if u0.get("last_ping_ok", True) else 60 * 60
            if now() - (u0.get("last_ping") or 0) > backoff:
                okp = do_ping(cfg, acct, why)
                if okp:
                    pinged = acct["name"]
                nu = fetch_account_usage(cfg, acct)
                nu["last_ping"], nu["last_ping_ok"] = now(), okp
                st["accounts"][acct["name"]] = nu
                acct, why, due = plan_pings(cfg, st)
        if not enabled:
            why = "自动提前计时已关闭"
        elif not active:
            why = f"现在不在自动计时时段（{cfg['active_hours']['start']}–{cfg['active_hours']['end']}）"
        idle_next = [x["name"] for x in prewarm_accounts(cfg) if not est_resets(st["accounts"].get(x["name"], {}))]
        idle_next.sort(key=lambda n: 0 if n == st.get("desktop_current") else 1)
        st["next_ping"] = {"at": due if enabled else None, "why": why,
                           "name": acct["name"] if acct else (idle_next[0] if idle_next else None)}
        rec = recommend(cfg, st)
        st["recommend"] = rec
        mode = cfg.get("auto_switch", "notify")
        cur = st.get("desktop_current")
        inter = interrupted_now(cfg, st) if cur else []
        st["interrupted"] = [{"session": i["session"], "title": i["title"]} for i in inter]
        cur_u = effective_util(st["accounts"].get(cur, {})) if cur else None
        exhausted = bool(inter) or (cur_u is not None and cur_u >= 99.5)
        app_up = bool(desktop_pids())
        check_after_switch(st, app_up)
        plan = None   # ("switch", 目标, 要续上的任务) / ("resume", None, 任务)
        if mode == "idle" and exhausted:
            if inter and cur_u is not None and cur_u < 90:      # 等的时候本号已经刷新
                plan = ("resume", None, inter)
            else:
                tgt = pick_target(cfg, st, exclude=cur)
                if tgt:
                    plan = ("switch", tgt, inter)
                    rec = {"action": "switch", "target": tgt, "urgent": True,
                           "reason": f"{lbl(cfg, cur)} 额度用完了" + ("，换号后自动续上被打断的任务" if inter else "")}
                    st["recommend"] = rec
                else:
                    soon = min((u.get("resets_at") for u in st["accounts"].values() if window_running(u)), default=None)
                    st["resume_wait"] = {"until": soon, "count": len(inter)}
                    if st.get("last_notified") != f"wait:{soon}":
                        notify((f"{hhmm(soon)} 有号刷新后，会自动换过去" + ("并续上被打断的任务" if inter else ""))
                               if soon else "等额度刷新后再继续", f"{accounts_text(len(cfg['accounts']))}都用完了")
                        st["last_notified"] = f"wait:{soon}"
        if not (mode == "idle" and exhausted and not plan):
            st.pop("resume_wait", None)
        if mode == "idle" and not plan and rec.get("action") == "switch" and not rec.get("urgent") \
                and app_up and now() - last_transcript_write(cfg) > 3600 and user_away(600):
            # 桌面版的 Claude Code 会话 1 小时没动静（缓存反正过期了，换号不多花），而且你 10 分钟没碰电脑。
            # 普通聊天的回复不写会话记录，所以要靠"你离开了"来保证不会在你聊天、打字时把 App 重启掉
            plan = ("switch", rec["target"], [])
        key = f"{rec.get('action')}:{rec.get('target')}"
        if mode != "idle" and rec.get("action") == "switch" and st.get("last_notified") != key and mode != "off":
            title = f"建议切换到 {lbl(cfg, rec['target'])}"
            msg = rec["reason"]
            if inter:
                title, msg = "任务被额度打断了", f"点「切换」换到 {lbl(cfg, rec['target'])}，并自动续上被打断的任务"
            notify(msg, title, kind="suggest", target=rec["target"])
            st["last_notified"] = key
        elif rec.get("action") != "switch" and not str(st.get("last_notified") or "").startswith("wait:"):
            st["last_notified"] = None
        _save_tick_state(cfg, st, notified0)
        if pinged:
            log(f"tick: pinged {pinged}")
    if plan and plan[0] == "switch":
        sw = load_state().get("switching") or {}
        if now() - (sw.get("since") or 0) < 20 * 60:     # 菜单栏/命令行正在换号：别再插一脚
            log(f"auto-switch to {plan[1]} skipped: switch to {sw.get('to')} already in progress")
            plan = None
    if plan and plan[0] == "resume":
        if cfg.get("auto_resume", True) and app_up:
            queue_resume(plan[2], "reset", delay=2)
    elif plan:
        log(f"auto-switch to {plan[1]} ({rec.get('reason')}, app {'running' if app_up else 'closed'})")
        try:
            # 自动换号要等你 30 秒没碰键盘鼠标，免得在你打字时把 App 关掉、草稿丢了
            do_switch(cfg, plan[1], after_turn=app_up, relaunch=app_up, resume=app_up,
                      user_idle=30 if app_up else 0)
        except SystemExit:
            pass
        except Exception as e:
            log(f"auto-switch failed: {e}")
    return load_state()


# ───────────────────────── 被额度打断的任务：检测 + 续上 ─────────────────────────

LIMIT_RE = re.compile(r"session limit|usage limit|5-hour limit|hit your limit|limit reached", re.I)
RESUME_MARK = "（Cduo）"
RESUME_TEXT = {
    "switch": RESUME_MARK + "上一轮因为额度用完被中断了，现在已换到另一个账号。请先确认刚才做到哪一步，再从中断的地方继续。",
    "reset": RESUME_MARK + "上一轮因为额度用完被中断了，现在额度已刷新。请先确认刚才做到哪一步，再从中断的地方继续。",
    "test": RESUME_MARK + "测试：这是 Cduo「自动续上」功能的测试消息，不用做任何事，回复「收到」即可。",
}


def _all_pointers() -> list:
    """所有 账号/组织 文件夹里的会话记录，按 sessionId 去重（取最新）。"""
    best = {}
    if not SESSIONS_ROOT.is_dir():
        return []
    for p in SESSIONS_ROOT.glob("*/*/local_*.json"):
        try:
            d = json.loads(p.read_text(encoding="utf-8"))
        except Exception:
            continue
        sid = d.get("sessionId") or f"local_{_uuid_of(p.name)}"
        d["sessionId"] = sid
        if sid not in best or (d.get("lastActivityAt") or 0) > (best[sid].get("lastActivityAt") or 0):
            best[sid] = d
    return list(best.values())


def transcript_for(cfg: dict, cli_id) -> str | None:
    if not cli_id or not re.match(r"^[0-9a-f-]{36}$", str(cli_id)):
        return None
    found = []
    for d in cfg.get("projects_dirs") or []:
        found += glob_paths(os.path.join(os.path.expanduser(d), "*", f"{cli_id}.jsonl"))
    return max(found, key=os.path.getmtime) if found else None


def tail_entries(path: str, max_bytes: int = 400_000) -> list:
    with open(path, "rb") as f:
        f.seek(0, 2)
        size = f.tell()
        f.seek(max(0, size - max_bytes))
        data = f.read()
    lines = data.split(b"\n")
    if size > max_bytes:
        lines = lines[1:]
    out = []
    for line in lines:
        line = line.strip()
        if line:
            with contextlib.suppress(Exception):
                out.append(json.loads(line))
    return out


def is_auto_message(e: dict) -> bool:
    """不是你打的字：后台任务完成通知、其他会话发来的消息等（origin.kind 不是 human）。"""
    o = e.get("origin")
    return e.get("type") == "user" and isinstance(o, dict) and o.get("kind") not in (None, "human")


def last_turn_entry(entries: list):
    """最后一条真正的对话记录（跳过系统记录、子任务、元信息、自动消息）。"""
    for e in reversed(entries):
        if e.get("type") in ("user", "assistant") and not e.get("isSidechain") and not e.get("isMeta") \
                and not is_auto_message(e):
            return e
    return None


def entry_text(e: dict) -> str:
    c = (e.get("message") or {}).get("content")
    if isinstance(c, str):
        return c
    return " ".join(x.get("text", "") for x in (c or []) if isinstance(x, dict) and x.get("type") == "text")


def is_limit_error(e) -> bool:
    """Claude Code 撞上 5 小时额度时写入的报错，例如 "You've hit your session limit · resets 2:30pm"。"""
    if not e or e.get("type") != "assistant" or not e.get("isApiErrorMessage") or e.get("error") != "rate_limit":
        return False
    t = entry_text(e)
    return bool(LIMIT_RE.search(t)) and "spend" not in t.lower()


def find_interrupted(cfg: dict, since: float) -> list:
    """被额度打断、之后没人再动过的会话：最后一条对话记录就是额度报错，且发生在 since 之后。

    你自己停掉的、看到报错后又发过消息的、空闲时没在跑的会话都不算。
    """
    res = []
    for d in _all_pointers():
        if d.get("isArchived"):
            continue
        path = transcript_for(cfg, d.get("cliSessionId"))
        if not path or os.path.getmtime(path) < since - 5:
            continue
        try:
            e = last_turn_entry(tail_entries(path))
        except Exception:
            continue
        if not is_limit_error(e):
            continue
        ts = parse_iso(e.get("timestamp")) or os.path.getmtime(path)
        if ts < since:
            continue
        res.append({"session": d["sessionId"], "cli": d.get("cliSessionId"), "title": d.get("title") or "",
                    "error_uuid": e.get("uuid") or f"{d['sessionId']}@{ts:.0f}", "at": ts})
    return res


def interrupted_now(cfg: dict, st: dict) -> list:
    """本账号用着时（上次换号之后）被打断、还没处理过的任务。"""
    since = max((st.get("last_switch") or {}).get("at", 0), now() - 6 * 3600)
    handled = st.get("resume_handled") or {}
    return [i for i in find_interrupted(cfg, since) if i["error_uuid"] not in handled]


def load_resume_q() -> dict:
    try:
        q = read_json(RESUME_Q, None)
    except RuntimeError:
        q = None
    return q if isinstance(q, dict) and isinstance(q.get("items"), list) else {"items": []}


def queue_resume(items: list, kind: str, delay: float = 12) -> int:
    """交给菜单栏 App：打开会话、粘贴一句"继续"、回车。"""
    if not items:
        return 0
    with file_lock("resumeq"):   # 菜单栏的 resume next/check 也在改这个文件
        q = load_resume_q()
        have = {i.get("error_uuid") for i in q["items"]}
        added = 0
        for it in items:
            if it["error_uuid"] in have:
                continue
            q["items"].append(dict(it, kind=kind, message=RESUME_TEXT.get(kind, RESUME_TEXT["switch"]),
                                   state="pending", attempts=0, queued_at=now(), not_before=now() + delay))
            added += 1
        q["items"] = [i for i in q["items"] if i.get("state") in ("pending", "typing")
                      or now() - i.get("queued_at", 0) < 86400][-30:]
        write_json(RESUME_Q, q)

    def mark(st):
        h = st.setdefault("resume_handled", {})
        for it in items:
            h[it["error_uuid"]] = now()
        st["resume_handled"] = {k: v for k, v in h.items() if now() - v < 2 * 86400}
    update_state(mark)
    if added:
        log(f"resume queued ({kind}): " + ", ".join(i.get("title") or i["session"] for i in items))
        if not menubar_alive():
            notify("Cduo 菜单栏没在运行，无法自动续上。打开原来的会话发一句「继续」即可。", "任务被额度打断")
    return added


def _resume_item(q: dict, sid: str):
    return next((i for i in q["items"] if i.get("session") == sid and i.get("state") in ("pending", "typing")), None)


def _marker_ts(path, t0: float) -> float:
    """这份会话记录里，t0 之后 Cduo 那句续上的话最晚一次出现的时间；没有就是 0。"""
    best = 0.0
    if not path:
        return best
    try:
        for e in tail_entries(path):
            if e.get("type") == "user" and RESUME_MARK in entry_text(e):
                ts = parse_iso(e.get("timestamp")) or 0
                if ts >= t0:
                    best = max(best, ts)
    except OSError:
        pass
    return best


def _marker_in(path, t0: float) -> bool:
    return _marker_ts(path, t0) > 0


def _marker_elsewhere(cfg: dict, t0: float, exclude_cli):
    """续上的话没出现在目标会话里时，看看是不是发进了别的会话；是的话返回那个会话的标题。

    同一时段别的会话也可能刚被正常续上过，所以取这句话出现得最晚的那个会话。
    """
    idx = _transcript_index(cfg)
    best, best_ts = None, 0.0
    for d in _all_pointers():
        cli = str(d.get("cliSessionId") or "")
        if not cli or cli == exclude_cli:
            continue
        p = idx.get(cli)
        try:
            if not p or os.path.getmtime(p) < t0:
                continue
        except OSError:
            continue
        ts = _marker_ts(p, t0)
        if ts > best_ts:
            best, best_ts = d.get("title") or d.get("sessionId"), ts
    return best


def cmd_resume(args, cfg):
    """resume SESSION        手动排一个续上任务（测试用，会话可写 last）
       resume next           菜单栏取下一个要续上的任务（JSON）
       resume check SESSION  菜单栏发完后核对：会话里出现了续上的消息才算成功
       resume defer|manual|fail SESSION"""
    act, sid = args.action, args.session
    if act == "next":
        if not desktop_pids():
            print("{}")
            return
        with file_lock("resumeq"):
            q = load_resume_q()
            due = [i for i in q["items"] if i.get("state") == "pending" and i.get("not_before", 0) <= now()]
            if not due:
                print("{}")
                return
            it = due[0]
            it["state"], it["attempts"], it["started_at"] = "typing", it.get("attempts", 0) + 1, now()
            write_json(RESUME_Q, q)
        print(json.dumps(it, ensure_ascii=False))
        return
    if act in ("check", "defer", "manual", "fail"):
        it0 = _resume_item(load_resume_q(), sid)
        if not it0:
            print(json.dumps({"ok": False, "final": True}))
            return
        ok, elsewhere = False, None
        if act == "check":   # 核对时不拿锁：会话记录可能晚几秒才写，要等一会儿
            t0 = it0.get("started_at", 0) - 5
            deadline = now() + RESUME_CHECK_WAIT
            while True:
                ok = _marker_in(transcript_for(cfg, it0.get("cli")), t0)
                if ok or now() >= deadline:
                    break
                time.sleep(1)
            if not ok:
                elsewhere = _marker_elsewhere(cfg, t0, it0.get("cli"))
        with file_lock("resumeq"):
            q = load_resume_q()
            it = _resume_item(q, sid)
            if not it:
                print(json.dumps({"ok": ok, "final": True}))
                return
            final = True
            if ok:
                it["state"] = "done"
                log(f"resumed: {it.get('title') or sid}")
            elif act == "defer":                    # 你正在用电脑，还没粘贴：晚点再试
                waited = now() - it.get("queued_at", now())
                if waited < 180:
                    it["state"], it["not_before"], final = "pending", now() + 20, False
                else:
                    it["state"] = "manual"
            elif act == "check":
                # 已经粘贴、按过回车，却没在目标会话里看到这句话：不再自动重试。
                # 重试可能把同一句话再发进别的会话，或者在输入框里叠两份。改为通知你手动处理。
                if elsewhere:
                    it["state"], it["misdelivered_to"] = "misdelivered", elsewhere
                else:
                    it["state"] = "manual"
                log(f"resume {it['state']}: {it.get('title') or sid}"
                    + (f" (the message showed up in {elsewhere!r})" if elsewhere else ""))
            else:
                it["state"] = "manual" if act == "manual" else "failed"
                log(f"resume {it['state']}: {it.get('title') or sid}")
            write_json(RESUME_Q, q)
            out = {"ok": ok, "final": final, "state": it["state"], "message": it.get("message"),
                   "title": it.get("title"), "misdelivered_to": elsewhere}
        print(json.dumps(out, ensure_ascii=False))
        return
    # 手动排队（测试用）
    me = os.environ.get("CLAUDE_CODE_HOST_SESSION_ID")
    ptrs = [x for x in _all_pointers() if not x.get("isArchived")]
    if sid == "test":   # 最新建的那个会话（不含正在运行这条命令的会话），发一句无害的测试消息
        ptrs = sorted((x for x in ptrs if x["sessionId"] != me), key=lambda d: d.get("createdAt") or 0, reverse=True)
        args.kind = "test"
    else:
        ptrs.sort(key=lambda d: d.get("lastActivityAt") or 0, reverse=True)
    d = ptrs[0] if sid in (None, "last", "test") and ptrs else next((x for x in ptrs if x["sessionId"] == sid), None)
    if not d:
        die("找不到这个会话（用 local_… 形式的 id，或写 last / test）")
    item = {"session": d["sessionId"], "cli": d.get("cliSessionId"), "title": d.get("title") or "",
            "error_uuid": f"manual-{now():.0f}", "at": now()}
    queue_resume([item], args.kind or "switch", delay=float(args.delay))
    print(f"✓ 已排队：约 {int(float(args.delay))} 秒后，菜单栏会打开「{item['title'] or d['sessionId']}」并发一句续上的话")


def pick_target(cfg: dict, st: dict, exclude=None):
    """还有余量（<90%）的号里，选最早刷新的那个（EDF）。"""
    c = []
    for a in cfg["accounts"]:
        n = a["name"]
        if n == exclude or not has_profile(n):
            continue
        u = st["accounts"].get(n, {})
        eu = effective_util(u)
        if eu is None or eu >= 90:
            continue
        c.append((0 if window_running(u) else 1, u.get("resets_at") if window_running(u) else 9e12, n))
    return min(c)[2] if c else None


