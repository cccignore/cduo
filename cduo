def spawn_detached(args: list) -> None:
    LOGDIR.mkdir(parents=True, exist_ok=True)
    _rotate(LOGDIR / "switch.log")
    out = open(LOGDIR / "switch.log", "a")
    env = {k: v for k, v in os.environ.items() if not k.startswith("CLAUDE_CODE_")}
    subprocess.Popen([sys.executable, os.path.abspath(__file__)] + args, stdin=subprocess.DEVNULL,
                     stdout=out, stderr=out, start_new_session=True, env=env, cwd=str(HOME))


def do_switch(cfg: dict, target: str, after_turn: bool = False, relaunch: bool = True, force: bool = False,
              resume: bool = True, user_idle: float = 0) -> None:
    """user_idle>0：还要等你这么多秒没碰键盘鼠标再重启 Claude（自动换号用）。"""
    get_account(cfg, target)
    if not has_profile(target):
        die(f"{target} 还没有桌面版登录快照。先在桌面版登录它，然后运行 cduo capture {target}")
    st = load_state()
    cur = current_desktop_profile(cfg, st)
    if cur == target and not force:
        print(f"桌面版已经是 {lbl(cfg, target)}")
        return
    T = lbl(cfg, target)

    def phase(p):  # 给菜单栏看的进度
        update_state(lambda s: s.__setitem__("switching", {"to": target, "phase": p, "since": now()} if p else None))

    # 桌面版的文件不是 cduo 认识的样子（Claude 大版本更新可能改掉）：一个文件都不碰，也不用等、不用重启
    problems = desktop_compat_problems()
    if problems:
        log("switch refused: " + "; ".join(problems))
        notify("Claude 的数据结构和 Cduo 认识的不一样，为免弄坏登录没有换号。运行 cduo doctor 看详情", "切换取消")
        die("没有换号：" + "；".join(problems))
    if after_turn and desktop_pids():
        phase("waiting")
        log(f"switch→{target}: waiting for idle")
        if not wait_idle(cfg, user_idle=user_idle):
            phase(None)
            why = "你一直在用电脑" if getattr(wait_idle, "last_reason", "") == "user" else "Claude 一直在回复"
            notify(f"{why}，切换已取消，稍后再试", "切换取消")
            die(f"等了 15 分钟，{why}，取消切换")
    # 只有"被额度打断、之后没人动过"的任务才自动续上；正常换号什么都不发
    to_resume = interrupted_now(cfg, load_state()) if resume and cfg.get("auto_resume", True) else []
    ver = desktop_app_version()
    seen = st.get("desktop_versions_ok") or []
    new_ver = bool(ver and seen and ver not in seen)   # Claude 更新后第一次换号
    with file_lock("switch"):
        was_running = bool(desktop_pids())
        phase("restarting")
        notify("Claude 会自动重启，约 10 秒", f"正在切换到 {T}")
        try:
            quit_desktop()
        except Exception as e:
            phase(None)
            die(str(e))
        bk = backup_desktop(f"to-{target}")
        try:
            if cur:
                save_profile(cur)          # 桌面版会轮换 token，必须先把最新的存回去
            elif desktop_account_uuid() and not force:
                raise RuntimeError("桌面版当前登录的账号不在 cduo 里，为免丢失登录已取消。先 cduo capture <名字>")
            restore_profile(target)
        except Exception as e:
            # 写到一半失败：放回刚做的备份，免得桌面版卡在"一半新号、一半旧号"的状态
            rolled = False
            if bk:
                try:
                    restore_desktop_backup(bk)
                    rolled = True
                except Exception as e2:
                    log(f"rollback from {bk.name} failed: {e2}")
            phase(None)
            if was_running:
                launch_desktop()
            log(f"switch to {target} failed: {e}" + ("（rolled back）" if rolled else ""))
            die(f"{e}" + ("（已恢复到切换前的登录）" if rolled else
                          (f"（自动恢复失败，可以运行 cduo restore {bk.name} 手动恢复）" if bk else "")))
        pin_org_for(cfg, target)           # 固定组织失败不影响换号（里面自己兜底）
        try:
            s = sync_sessions()
        except Exception as e:             # 会话列表同步失败也不影响换号，后台调度会再补
            log(f"sync_sessions after switch failed: {e}")
            s = {"error": str(e)[:80]}

        def done(st2):
            st2["desktop_current"] = target
            st2["last_switch"] = {"at": now(), "from": cur, "to": target}
            st2["last_notified"] = None
            st2["switching"] = None
            if ver:
                st2["desktop_versions_ok"] = ([v for v in (st2.get("desktop_versions_ok") or []) if v != ver]
                                              + [ver])[-10:]
        update_state(done)
        if relaunch and (was_running or not FAKE_DESKTOP):
            launch_desktop()
    msg = f"已切换到 {T}"
    log(f"switch {cur} -> {target} {s}" + (f" (first switch on Claude {ver})" if new_ver else ""))
    tip = (f"\nClaude 更新到了 {ver}，这是第一次在新版本上换号。如果打开后要求重新登录，运行 cduo restore latest"
           if new_ver else "")
    if to_resume and relaunch and was_running:
        queue_resume(to_resume, "switch")
        notify(f"Claude 打开后会自动续上 {len(to_resume)} 个被额度打断的任务" + tip, msg)
    else:
        notify("点开原来的会话就能接着聊" + tip, msg)
    print(f"{C['g']}✓ {msg}{C['r']}")


