def find_claude_bin() -> str | None:
    cands = []
    w = shutil.which("claude")
    if w:
        cands.append(w)
    cands += sorted(glob_paths(str(HOME / ".nvm/versions/node/*/bin/claude")), reverse=True)
    cands += [str(HOME / ".local/bin/claude"), "/opt/homebrew/bin/claude", "/usr/local/bin/claude",
              str(HOME / ".claude/local/claude")]
    for c in cands:
        p = pathlib.Path(c)
        if not p.exists():
            continue
        try:  # 跳过 shell 包装脚本（比如会强行设置 CLAUDE_CONFIG_DIR 的那种）
            with open(p.resolve(), "rb") as fh:
                head = fh.read(4000)
            if head.startswith(b"#!") and b"CLAUDE_CONFIG_DIR" in head:
                continue
        except Exception:
            pass
        return str(p)
    # 没单独装 Claude Code 的话，用桌面版自带的那份（版本号目录会随更新变化）
    def _ver(path):
        try:
            return tuple(int(x) for x in pathlib.Path(path).parts[-6].split("."))
        except Exception:
            return ()
    bundled = glob_paths(str(APP_SUPPORT / "claude-code/*/*/claude.app/Contents/MacOS/claude"))
    for c in sorted(bundled, key=_ver, reverse=True):
        if os.access(c, os.X_OK):
            return c
    return None


def glob_paths(pattern: str):
    import glob
    return glob.glob(pattern)


def system_proxy() -> str | None:
    try:
        out = subprocess.run(["scutil", "--proxy"], capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return None
    kv = dict(re.findall(r"^\s*(\w+)\s*:\s*(\S+)\s*$", out, re.M))
    if kv.get("HTTPSEnable") == "1" and kv.get("HTTPSProxy"):
        return f"http://{kv['HTTPSProxy']}:{kv.get('HTTPSPort', '80')}"
    if kv.get("HTTPEnable") == "1" and kv.get("HTTPProxy"):
        return f"http://{kv['HTTPProxy']}:{kv.get('HTTPPort', '80')}"
    return None


def proxy_url(cfg: dict) -> str | None:
    p = cfg.get("proxy", "auto")
    if p == "auto":
        return system_proxy()
    return p or None


def clean_env(cfg: dict, cli_dir: str | None = None) -> dict:
    """给 claude 子进程一个干净环境：去掉桌面版/中转注入的变量，只保留正常代理。"""
    env = {}
    for k, v in os.environ.items():
        if k.startswith(("ANTHROPIC_", "CLAUDE_CODE_")) or k in ("CLAUDECODE", "CLAUDE_CONFIG_DIR", "__CFBundleIdentifier"):
            continue
        if k.lower() in ("http_proxy", "https_proxy", "all_proxy") and (":64421" in v or ":64422" in v):
            continue  # ReClaude 的拦截代理
        if k in ("NODE_EXTRA_CA_CERTS", "SSL_CERT_FILE", "SSL_CERT_DIR") and "/.reclaude/" in v:
            continue
        env[k] = v
    px = proxy_url(cfg)
    if px and not any(k.lower() == "https_proxy" for k in env):
        env["HTTPS_PROXY"] = env["HTTP_PROXY"] = px
        env.setdefault("NO_PROXY", "localhost,127.0.0.1,::1,.local")
    path = env.get("PATH", "")
    extra = ["/usr/bin", "/bin", "/usr/sbin", "/sbin"]
    if cfg.get("claude_bin"):
        extra.insert(0, str(pathlib.Path(cfg["claude_bin"]).parent))
    env["PATH"] = ":".join([p for p in extra if p not in path.split(":")] + ([path] if path else []))
    if cli_dir:
        env["CLAUDE_CONFIG_DIR"] = cli_dir
    return env


def http_json(cfg: dict, url: str, data: dict | None = None, headers: dict | None = None, timeout=20):
    px = proxy_url(cfg)
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({"http": px, "https": px} if px else {}))
    h = {"User-Agent": "claude-cli/2.1.316 (external, cli)"}
    h.update(headers or {})
    body = None
    if data is not None:
        body = json.dumps(data).encode()
        h["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=body, headers=h)
    with opener.open(req, timeout=timeout) as r:
        return json.loads(r.read())


# ───────────────────────── CLI 凭据（钥匙串） ─────────────────────────

def kc_service(cli_dir: str) -> str:
    if os.path.normpath(cli_dir) == os.path.normpath(str(HOME / ".claude")):
        return "Claude Code-credentials"
    return "Claude Code-credentials-" + hashlib.sha256(cli_dir.encode("utf-8")).hexdigest()[:8]


def read_creds(cli_dir: str):
    f = pathlib.Path(cli_dir) / ".credentials.json"
    if f.exists():
        try:
            return json.loads(f.read_text()), "file"
        except Exception:
            pass
    out = subprocess.run(["security", "find-generic-password", "-a", os.environ.get("USER", ""),
                          "-w", "-s", kc_service(cli_dir)], capture_output=True, text=True, timeout=10)
    if out.returncode != 0 or not out.stdout.strip():
        return None, None
    try:
        return json.loads(out.stdout.strip()), "keychain"
    except Exception:
        return None, None


def write_creds(cli_dir: str, full: dict, where: str) -> None:
    raw = json.dumps(full, separators=(",", ":"))
    if where == "file":
        f = pathlib.Path(cli_dir) / ".credentials.json"
        f.write_text(raw)
        os.chmod(f, 0o600)
        return
    user = os.environ.get("USER", "")
    cmd = f'add-generic-password -U -a "{user}" -s "{kc_service(cli_dir)}" -X {raw.encode().hex()}\n'
    p = subprocess.run(["security", "-i"], input=cmd, capture_output=True, text=True, timeout=10)
    if p.returncode != 0:
        raise RuntimeError("写钥匙串失败: " + p.stderr.strip())


def cli_identity(cli_dir: str) -> dict:
    p = pathlib.Path(cli_dir)
    f = (HOME / ".claude.json") if os.path.normpath(cli_dir) == os.path.normpath(str(HOME / ".claude")) else p / ".claude.json"
    a = (read_json(f, {}) or {}).get("oauthAccount") or {}
    return {"account_uuid": a.get("accountUuid"), "org_uuid": a.get("organizationUuid"),
            "email": a.get("emailAddress"), "org_name": a.get("organizationName")}


def ensure_fresh_token(cfg: dict, acct: dict, force: bool = False) -> str | None:
    """返回可用的 access token。只有 cduo 自己的 CLI 目录（owned）才会主动刷新。"""
    cli_dir = acct["cli_dir"]
    full, where = read_creds(cli_dir)
    if not full or "claudeAiOauth" not in full:
        return None
    c = full["claudeAiOauth"]
    fresh = c.get("expiresAt", 0) / 1000 - now() > 20 * 60
    if fresh and not force:
        return c.get("accessToken")
    if not acct.get("owned") or not c.get("refreshToken"):
        return c.get("accessToken") if fresh else None
    lock = pathlib.Path(cli_dir) / ".oauth_refresh.lock"
    try:
        lock.mkdir()
    except FileExistsError:
        if now() - lock.stat().st_mtime < 120:
            return None
        shutil.rmtree(lock, ignore_errors=True)
        lock.mkdir()
    try:
        r = http_json(cfg, TOKEN_URL, {"grant_type": "refresh_token", "refresh_token": c["refreshToken"],
                                       "client_id": CLIENT_ID, "scope": " ".join(c.get("scopes") or [])}, timeout=30)
        t = int(now() * 1000)
        c["accessToken"] = r["access_token"]
        c["refreshToken"] = r.get("refresh_token") or c["refreshToken"]
        c["expiresAt"] = t + int(r["expires_in"]) * 1000
        if r.get("refresh_token_expires_in"):
            c["refreshTokenExpiresAt"] = t + int(r["refresh_token_expires_in"]) * 1000
        if r.get("scope"):
            c["scopes"] = r["scope"].split()
        write_creds(cli_dir, full, where)
        log(f"refreshed CLI token for {acct['name']}")
        return c["accessToken"]
    except Exception as e:
        log(f"token refresh failed for {acct['name']}: {e}")
        return None
    finally:
        shutil.rmtree(lock, ignore_errors=True)


def fetch_account_usage(cfg: dict, acct: dict) -> dict:
    res = {"fetched": now(), "util": None, "resets_at": None, "ok": False, "error": None, "no5h": False}
    tok = ensure_fresh_token(cfg, acct)
    if not tok:
        res["error"] = "凭据过期/未登录"
        return res
    try:
        u = http_json(cfg, USAGE_URL, headers={"Authorization": f"Bearer {tok}", "anthropic-beta": "oauth-2025-04-20"})
    except urllib.error.HTTPError as e:
        res["error"] = f"HTTP {e.code}"
        return res
    except Exception as e:
        res["error"] = str(e)[:80]
        return res
    fh = u.get("five_hour")
    res["ok"] = True
    if not fh:
        res["no5h"] = True
        return res
    res["util"] = float(fh.get("utilization") or 0)
    res["resets_at"] = parse_iso(fh.get("resets_at"))
    sd = u.get("seven_day")
    if sd:
        res["weekly_util"] = sd.get("utilization")
        res["weekly_resets_at"] = parse_iso(sd.get("resets_at"))
    return res


def window_running(u: dict) -> bool:
    return bool(u and u.get("resets_at") and u["resets_at"] > now())


def est_resets(u: dict):
    """窗口重置时间；接口拿不到时，用最近一次成功预热时间估算，避免反复预热。"""
    if u and u.get("ok") and not u.get("no5h"):
        return u["resets_at"] if window_running(u) else None
    lp = (u or {}).get("last_ping") if (u or {}).get("last_ping_ok", True) else None
    if lp and lp + WINDOW > now():
        return lp + WINDOW
    return None


def effective_util(u: dict):
    """窗口已过期 = 实际可用 100%。"""
    if not u or not u.get("ok"):
        return None
    if u.get("no5h"):
        return 0.0
    return u["util"] if window_running(u) else 0.0


def do_ping(cfg: dict, acct: dict, reason: str) -> bool:
    claude = cfg.get("claude_bin")
    if not claude:
        log("ping skipped: claude_bin not set")
        return False
    if DRY_PING:
        log(f"[dry] ping {acct['name']} ({reason})", echo=True)
        return True
    pingdir = CDUO / "ping"
    pingdir.mkdir(parents=True, exist_ok=True)
    cmd = [claude, "-p", "Reply with just: ok", "--model", "haiku", "--tools", "",
           "--strict-mcp-config", "--setting-sources", "", "--no-session-persistence",
           "--output-format", "json"]
    try:
        p = subprocess.run(cmd, cwd=pingdir, env=clean_env(cfg, acct["cli_dir"]),
                           capture_output=True, text=True, timeout=180)
        try:
            ok = p.returncode == 0 and json.loads(p.stdout).get("is_error") is False
        except Exception:
            ok = False
        log(f"ping {acct['name']} ({reason}) -> {'ok' if ok else 'FAIL'} {'' if ok else (p.stdout + p.stderr)[-300:]}")
        return ok
    except Exception as e:
        log(f"ping {acct['name']} error: {e}")
        return False


# ───────────────────────── 桌面版：进程 ─────────────────────────

def desktop_pids() -> list:
    if FAKE_DESKTOP:
        return []
    # pgrep 在某些沙箱里看不到 App 进程，用 ps 按可执行路径匹配（区分大小写，避开内置的 claude.app/…/claude）
    out = subprocess.run(["ps", "-axo", "pid=,comm="], capture_output=True, text=True).stdout
    pids = []
    for line in out.splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) == 2 and re.search(r"/Claude\.app/Contents/MacOS/Claude$", parts[1]):
            pids.append(int(parts[0]))
    return pids


def quit_desktop(timeout: int = 40) -> None:
    if FAKE_DESKTOP or not desktop_pids():
        return
    subprocess.run(["osascript", "-e", f'tell application id "{BUNDLE_ID}" to quit'], capture_output=True, timeout=30)
    t0 = now()
    while desktop_pids() and now() - t0 < timeout:
        time.sleep(0.5)
    if desktop_pids():
        for pid in desktop_pids():
            with contextlib.suppress(Exception):
                os.kill(pid, signal.SIGTERM)
        t0 = now()
        while desktop_pids() and now() - t0 < 15:
            time.sleep(0.5)
    if desktop_pids():
        raise RuntimeError("Claude 桌面版退不掉，请手动退出后重试")
    time.sleep(1.0)  # 等它把 config/cookies 刷完


def launch_desktop() -> None:
    if FAKE_DESKTOP:
        return
    subprocess.run(["open", "-b", BUNDLE_ID], capture_output=True)


def last_transcript_write(cfg: dict) -> float:
    newest = 0.0
    for d in cfg.get("projects_dirs") or []:
        base = pathlib.Path(os.path.expanduser(d))
        if not base.is_dir():
            continue
        for proj in os.scandir(base):
            if not proj.is_dir():
                continue
            try:
                if proj.stat().st_mtime < newest - 5:
                    pass
                for e in os.scandir(proj.path):
                    if e.name.endswith(".jsonl"):
                        newest = max(newest, e.stat().st_mtime)
                    elif e.is_dir():  # <session>/subagents/*.jsonl
                        sub = os.path.join(e.path, "subagents")
                        if os.path.isdir(sub):
                            for s in os.scandir(sub):
                                newest = max(newest, s.stat().st_mtime)
            except (FileNotFoundError, PermissionError):
                continue
    return newest


def wait_idle(cfg: dict, quiet: int = 12, max_wait: int = 900) -> bool:
    t0 = now()
    calm = 0
    while now() - t0 < max_wait:
        if now() - last_transcript_write(cfg) >= quiet:
            calm += 1
            if calm >= 2:
                return True
        else:
            calm = 0
        time.sleep(2)
    return False


