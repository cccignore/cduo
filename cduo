LIMIT_RE = re.compile(r"session limit|usage limit|5-hour limit|hit your limit|limit reached", re.I)
RESUME_MARK = "（Cduo）"
RESUME_TEXT = {
    "switch": RESUME_MARK + "上一轮因为额度用完被中断了，现在已换到另一个账号。请先确认刚才做到哪一步，再从中断的地方继续。",
    "reset": RESUME_MARK + "上一轮因为额度用完被中断了，现在额度已刷新。请先确认刚才做到哪一步，再从中断的地方继续。",
    "test": RESUME_MARK + "测试：这是 Cduo「自动续上」功能的测试消息，不用做任何事，回复「收到」即可。",
}


def _all_pointers() -> list:
    """所有 账号/组织 文件夹里的会话记录，按 sessionId 去重（取最新）。"""
    best = {}
    if not SESSIONS_ROOT.is_dir():
        return []
    for p in SESSIONS_ROOT.glob("*/*/local_*.json"):
        try:
            d = json.loads(p.read_text(encoding="utf-8"))
        except Exception:
            continue
        sid = d.get("sessionId") or f"local_{_uuid_of(p.name)}"
        d["sessionId"] = sid
        if sid not in best or (d.get("lastActivityAt") or 0) > (best[sid].get("lastActivityAt") or 0):
            best[sid] = d
    return list(best.values())


def transcript_for(cfg: dict, cli_id) -> str | None:
    if not cli_id or not re.match(r"^[0-9a-f-]{36}$", str(cli_id)):
        return None
    found = []
    for d in cfg.get("projects_dirs") or []:
        found += glob_paths(os.path.join(os.path.expanduser(d), "*", f"{cli_id}.jsonl"))
    return max(found, key=os.path.getmtime) if found else None


def tail_entries(path: str, max_bytes: int = 400_000) -> list:
    with open(path, "rb") as f:
        f.seek(0, 2)
        size = f.tell()
        f.seek(max(0, size - max_bytes))
        data = f.read()
    lines = data.split(b"\n")
    if size > max_bytes:
        lines = lines[1:]
    out = []
    for line in lines:
        line = line.strip()
        if line:
            with contextlib.suppress(Exception):
                out.append(json.loads(line))
    return out


def is_auto_message(e: dict) -> bool:
    """不是你打的字：后台任务完成通知、其他会话发来的消息等（origin.kind 不是 human）。"""
    o = e.get("origin")
    return e.get("type") == "user" and isinstance(o, dict) and o.get("kind") not in (None, "human")


def last_turn_entry(entries: list):
    """最后一条真正的对话记录（跳过系统记录、子任务、元信息、自动消息）。"""
    for e in reversed(entries):
        if e.get("type") in ("user", "assistant") and not e.get("isSidechain") and not e.get("isMeta") \
                and not is_auto_message(e):
            return e
    return None


def entry_text(e: dict) -> str:
    c = (e.get("message") or {}).get("content")
    if isinstance(c, str):
        return c
    return " ".join(x.get("text", "") for x in (c or []) if isinstance(x, dict) and x.get("type") == "text")


def is_limit_error(e) -> bool:
    """Claude Code 撞上 5 小时额度时写入的报错，例如 "You've hit your session limit · resets 2:30pm"。"""
    if not e or e.get("type") != "assistant" or not e.get("isApiErrorMessage") or e.get("error") != "rate_limit":
        return False
    t = entry_text(e)
    return bool(LIMIT_RE.search(t)) and "spend" not in t.lower()


def find_interrupted(cfg: dict, since: float) -> list:
    """被额度打断、之后没人再动过的会话：最后一条对话记录就是额度报错，且发生在 since 之后。

    你自己停掉的、看到报错后又发过消息的、空闲时没在跑的会话都不算。
    """
    res = []
    for d in _all_pointers():
        if d.get("isArchived"):
            continue
        path = transcript_for(cfg, d.get("cliSessionId"))
        if not path or os.path.getmtime(path) < since - 5:
            continue
        try:
            e = last_turn_entry(tail_entries(path))
        except Exception:
            continue
        if not is_limit_error(e):
            continue
        ts = parse_iso(e.get("timestamp")) or os.path.getmtime(path)
        if ts < since:
            continue
        res.append({"session": d["sessionId"], "cli": d.get("cliSessionId"), "title": d.get("title") or "",
                    "error_uuid": e.get("uuid") or f"{d['sessionId']}@{ts:.0f}", "at": ts})
    return res


def interrupted_now(cfg: dict, st: dict) -> list:
    """本账号用着时（上次换号之后）被打断、还没处理过的任务。"""
    since = max((st.get("last_switch") or {}).get("at", 0), now() - 6 * 3600)
    handled = st.get("resume_handled") or {}
    return [i for i in find_interrupted(cfg, since) if i["error_uuid"] not in handled]


def load_resume_q() -> dict:
    try:
        q = read_json(RESUME_Q, None)
    except RuntimeError:
        q = None
    return q if isinstance(q, dict) and isinstance(q.get("items"), list) else {"items": []}


def queue_resume(items: list, kind: str, delay: float = 12) -> int:
    """交给菜单栏 App：打开会话、粘贴一句"继续"、回车。"""
    if not items:
        return 0
    q = load_resume_q()
    have = {i.get("error_uuid") for i in q["items"]}
    added = 0
    for it in items:
        if it["error_uuid"] in have:
            continue
        q["items"].append(dict(it, kind=kind, message=RESUME_TEXT.get(kind, RESUME_TEXT["switch"]),
                               state="pending", attempts=0, queued_at=now(), not_before=now() + delay))
        added += 1
    q["items"] = [i for i in q["items"] if i.get("state") in ("pending", "typing")
                  or now() - i.get("queued_at", 0) < 86400][-30:]
    write_json(RESUME_Q, q)
    st = load_state()
    h = st.setdefault("resume_handled", {})
    for it in items:
        h[it["error_uuid"]] = now()
    st["resume_handled"] = {k: v for k, v in h.items() if now() - v < 2 * 86400}
    save_state(st)
    if added:
        log(f"resume queued ({kind}): " + ", ".join(i.get("title") or i["session"] for i in items))
        if not menubar_alive():
            notify("Cduo 菜单栏没在运行，无法自动续上。打开原来的会话发一句「继续」即可。", "任务被额度打断")
    return added


def _resume_item(q: dict, sid: str):
    return next((i for i in q["items"] if i.get("session") == sid and i.get("state") in ("pending", "typing")), None)


def cmd_resume(args, cfg):
    """resume SESSION        手动排一个续上任务（测试用，会话可写 last）
       resume next           菜单栏取下一个要续上的任务（JSON）
       resume check SESSION  菜单栏发完后核对：会话里出现了续上的消息才算成功
       resume defer|manual|fail SESSION"""
    act, sid = args.action, args.session
    q = load_resume_q()
    if act == "next":
        due = [i for i in q["items"] if i.get("state") == "pending" and i.get("not_before", 0) <= now()]
        if not due or not desktop_pids():
            print("{}")
            return
        it = due[0]
        it["state"], it["attempts"], it["started_at"] = "typing", it.get("attempts", 0) + 1, now()
        write_json(RESUME_Q, q)
        print(json.dumps(it, ensure_ascii=False))
        return
    if act in ("check", "defer", "manual", "fail"):
        it = _resume_item(q, sid)
        if not it:
            print(json.dumps({"ok": False, "final": True}))
            return
        ok = False
        if act == "check":
            path = transcript_for(cfg, it.get("cli"))
            if path:
                t0 = it.get("started_at", 0) - 5
                for e in tail_entries(path):
                    ts = parse_iso(e.get("timestamp")) or 0
                    if e.get("type") == "user" and ts >= t0 and RESUME_MARK in entry_text(e):
                        ok = True
                        break
        final = True
        if ok:
            it["state"] = "done"
            log(f"resumed: {it.get('title') or sid}")
        elif act == "defer":                    # 你正在用电脑，晚点再试
            waited = now() - it.get("queued_at", now())
            if waited < 180:
                it["state"], it["not_before"], final = "pending", now() + 20, False
            else:
                it["state"] = "manual"
        elif act == "check" and it.get("attempts", 0) < 2:
            it["state"], it["not_before"], final = "pending", now() + 8, False
        else:
            it["state"] = "manual" if act in ("manual", "defer") else "failed"
            log(f"resume {it['state']}: {it.get('title') or sid}")
        write_json(RESUME_Q, q)
        print(json.dumps({"ok": ok, "final": final, "state": it["state"], "message": it.get("message"),
                          "title": it.get("title")}, ensure_ascii=False))
        return
    # 手动排队（测试用）
    me = os.environ.get("CLAUDE_CODE_HOST_SESSION_ID")
    ptrs = [x for x in _all_pointers() if not x.get("isArchived")]
    if sid == "test":   # 最新建的那个会话（不含正在运行这条命令的会话），发一句无害的测试消息
        ptrs = sorted((x for x in ptrs if x["sessionId"] != me), key=lambda d: d.get("createdAt") or 0, reverse=True)
        args.kind = "test"
    else:
        ptrs.sort(key=lambda d: d.get("lastActivityAt") or 0, reverse=True)
    d = ptrs[0] if sid in (None, "last", "test") and ptrs else next((x for x in ptrs if x["sessionId"] == sid), None)
    if not d:
        die("找不到这个会话（用 local_… 形式的 id，或写 last / test）")
    item = {"session": d["sessionId"], "cli": d.get("cliSessionId"), "title": d.get("title") or "",
            "error_uuid": f"manual-{now():.0f}", "at": now()}
    queue_resume([item], args.kind or "switch", delay=float(args.delay))
    print(f"✓ 已排队：约 {int(float(args.delay))} 秒后，菜单栏会打开「{item['title'] or d['sessionId']}」并发一句续上的话")


def pick_target(cfg: dict, st: dict, exclude=None):
    """还有余量（<90%）的号里，选最早刷新的那个（EDF）。"""
    c = []
    for a in cfg["accounts"]:
        n = a["name"]
        if n == exclude or not has_profile(n):
            continue
        u = st["accounts"].get(n, {})
        eu = effective_util(u)
        if eu is None or eu >= 90:
            continue
        c.append((0 if window_running(u) else 1, u.get("resets_at") if window_running(u) else 9e12, n))
    return min(c)[2] if c else None


