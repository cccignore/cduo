# ───────────────────────── 基础工具 ─────────────────────────

def now() -> float:
    return time.time()


def _rotate(p: pathlib.Path, max_bytes: int | None = None) -> None:
    """文件超过上限就改名成 .1（只留一份旧的），日志不会无限变大。"""
    try:
        if p.stat().st_size > (max_bytes or LOG_MAX):
            os.replace(p, p.with_name(p.name + ".1"))
    except OSError:
        pass


def rotate_logs() -> None:
    for name in ("cduo.log", "switch.log", "tick.out", "menubar.out"):
        _rotate(LOGDIR / name)


def log(msg: str, echo: bool = False) -> None:
    LOGDIR.mkdir(parents=True, exist_ok=True)
    p = LOGDIR / "cduo.log"
    _rotate(p)
    line = f"{dt.datetime.now():%Y-%m-%d %H:%M:%S} {msg}"
    with open(p, "a", encoding="utf-8") as f:
        f.write(line + "\n")
    if echo:
        print(msg)


def die(msg: str, code: int = 1) -> None:
    print(f"{C['red']}✗ {msg}{C['r']}", file=sys.stderr)
    log("ERROR " + msg)
    sys.exit(code)


def read_json(p: pathlib.Path, default=None):
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return default
    except Exception as e:  # 损坏的文件不要静默吞掉
        raise RuntimeError(f"读取 {p} 失败: {e}")


def write_json(p: pathlib.Path, data, mode: int = 0o600, indent=1) -> None:
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_name(f".{p.name}.tmp.{os.getpid()}")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=indent), encoding="utf-8")
    os.chmod(tmp, mode)
    os.replace(tmp, p)


@contextlib.contextmanager
def file_lock(name: str, blocking: bool = True):
    CDUO.mkdir(parents=True, exist_ok=True)
    fh = open(CDUO / f".{name}.lock", "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
    except BlockingIOError:
        fh.close()
        yield False
        return
    try:
        yield True
    finally:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()


def parse_iso(s):
    if not s:
        return None
    try:
        return dt.datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except Exception:
        return None


def hhmm(ts) -> str:
    if not ts:
        return "--:--"
    d = dt.datetime.fromtimestamp(ts)
    today = dt.date.today()
    if d.date() == today:
        return f"{d:%H:%M}"
    if d.date() == today + dt.timedelta(days=1):
        return f"明天{d:%H:%M}"
    return f"{d:%m-%d %H:%M}"


def dur(sec) -> str:
    if sec is None:
        return "-"
    sec = int(max(0, sec))
    h, m = divmod(sec // 60, 60)
    return f"{h}h{m:02d}m" if h else f"{m}m"


def menubar_alive() -> bool:
    try:
        return now() - (CDUO / ".menubar_alive").stat().st_mtime < 90
    except FileNotFoundError:
        return False


def notify(msg: str, title: str = "Cduo", kind: str = "info", target: str | None = None) -> None:
    """菜单栏 App 在跑时交给它发（带按钮、图标统一）；否则用系统通知兜底。

    每条通知单独写成 notify/ 下的一个文件：先写临时文件再改名，菜单栏只会看到写完整的文件，
    读完一个删一个。不会出现"菜单栏刚读完、这边又追加了一行，接着整个文件被删"而丢通知。
    """
    if os.environ.get("CDUO_NO_NOTIFY") == "1":
        return
    if menubar_alive():
        NOTIFY_DIR.mkdir(parents=True, exist_ok=True)
        name = f"{time.time_ns()}-{os.getpid()}-{os.urandom(4).hex()}.json"
        tmp = NOTIFY_DIR / f".{name}.tmp"
        tmp.write_text(json.dumps({"t": now(), "title": title, "msg": msg, "kind": kind, "target": target},
                                  ensure_ascii=False), encoding="utf-8")
        os.replace(tmp, NOTIFY_DIR / name)
        return
    esc = lambda s: s.replace("\\", "\\\\").replace('"', '\\"')
    subprocess.run(["osascript", "-e",
                    f'display notification "{esc(msg)}" with title "{esc(title)}"'],
                   capture_output=True)


def in_desktop_app() -> bool:
    """看环境变量：是不是从 Claude 桌面版里（对话或终端面板）启动的。"""
    return (os.environ.get("CLAUDE_CODE_ENTRYPOINT") == "claude-desktop"
            or os.environ.get("__CFBundleIdentifier") == BUNDLE_ID)


def under_claude_process() -> bool:
    """当前进程是不是 Claude 桌面版的子进程。是的话，Claude 一退出这里也会被杀掉。

    只看环境变量会误判（变量可能被别的终端继承），所以沿父进程链往上找 Claude.app。
    """
    if FAKE_DESKTOP:
        return False
    try:
        out = subprocess.run(["ps", "-axo", "pid=,ppid=,comm="], capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return in_desktop_app()
    procs = {}
    for line in out.splitlines():
        parts = line.strip().split(None, 2)
        if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
            procs[int(parts[0])] = (int(parts[1]), parts[2])
    pid, seen = os.getpid(), set()
    while pid in procs and pid > 1 and pid not in seen:
        seen.add(pid)
        ppid, comm = procs[pid]
        if "/Claude.app/Contents/" in comm:      # 桌面版主程序或它的 Helper（区分大小写，不含自带的 claude.app）
            return True
        pid = ppid
    return False


def open_in_terminal(argv: list) -> bool:
    """在 macOS 自带的「终端」App 里新开一个窗口运行 cduo 命令。"""
    import shlex
    script = CDUO / "run.command"
    CDUO.mkdir(parents=True, exist_ok=True)
    cmd = " ".join(shlex.quote(x) for x in [sys.executable, os.path.abspath(__file__)] + argv)
    script.write_text(f"#!/bin/zsh -l\nclear\n{cmd}\necho\nread -k1 \"?完成。按任意键关闭此窗口…\"\n", encoding="utf-8")
    os.chmod(script, 0o755)
    return subprocess.run(["open", "-a", "Terminal", str(script)], capture_output=True).returncode == 0


def need_real_terminal(argv: list, what: str) -> None:
    """这个命令会关掉 Claude；如果正跑在 Claude 里，就换到「终端」App 里去跑。"""
    if not under_claude_process():
        return
    if open_in_terminal(argv):
        print(f"{what}过程中要重启 Claude，不能在 Claude 里面运行。\n"
              f"已经在 macOS 的「终端」App 里打开了 cduo {' '.join(argv)}，请切到那个窗口继续。")
        sys.exit(0)
    die(f"{what}过程中要重启 Claude，请打开 macOS 自带的「终端」App（启动台 → 其他 → 终端）运行：cduo {' '.join(argv)}")


