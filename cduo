# ── CLI 登录走无痕窗口 ──
# 默认浏览器里已登录的 claude.ai / SSO 账号会顶替要登录的号，所以授权页放到默认浏览器的无痕窗口里打开。
# claude 打开授权页时优先用 BROWSER 环境变量指定的程序（以 URL 作唯一参数），这里给它一个小脚本。

PRIVATE_OPEN = CDUO / "open-private"
CHROMIUM_IDS = {"com.google.Chrome", "com.microsoft.edgemac", "com.brave.Browser", "org.chromium.Chromium",
                "com.vivaldi.Vivaldi", "com.citrolabs.ego.lite"}


def private_window_flag(app: str):
    """这个浏览器打开无痕窗口用的命令行参数；不支持返回 None（比如 Safari）。"""
    p = pathlib.Path(app)
    try:
        with open(p / "Contents/Info.plist", "rb") as f:
            bid = plistlib.load(f).get("CFBundleIdentifier", "")
    except Exception:
        bid = ""
    if bid.startswith("org.mozilla."):
        return "--private-window"
    if bid in CHROMIUM_IDS or any((p / "Contents/Frameworks").glob("* Framework.framework")):
        return "--incognito"
    return None


PRIVATE_CANDIDATES = ("/Applications/Google Chrome.app", "/Applications/Microsoft Edge.app",
                      "/Applications/Brave Browser.app", "/Applications/Firefox.app", "/Applications/ego lite.app")


def private_browser_helper(cfg: dict | None = None):
    """生成给 BROWSER 用的脚本：在无痕窗口里打开 URL。返回 (脚本路径, 浏览器名)，做不到返回 None。

    依次试 config 里的 login_browser、默认浏览器、常见的 Chromium/Firefox；Safari 没有命令行开隐私窗口的办法，会被跳过。
    """
    import shlex
    tries = [(cfg or {}).get("login_browser"), default_browser_path()] + list(PRIVATE_CANDIDATES)
    app = flag = None
    for t in tries:
        if t and pathlib.Path(t).exists():
            flag = private_window_flag(t)
            if flag:
                app = t
                break
    if not app:
        return None
    CDUO.mkdir(parents=True, exist_ok=True)
    PRIVATE_OPEN.write_text("#!/bin/zsh\n# cduo 生成：在无痕窗口里打开登录链接，免得浏览器里已登录的其他账号顶替\n"
                            f"exec /usr/bin/open -na {shlex.quote(app)} --args {flag} \"$1\"\n", encoding="utf-8")
    os.chmod(PRIVATE_OPEN, 0o755)
    return PRIVATE_OPEN, pathlib.Path(app).stem


def _undo_cli_login(cli_dir: str, creds, where, oauth_account) -> None:
    """把 CLI 目录的凭据和身份恢复到登录前。"""
    cred_file = pathlib.Path(cli_dir) / ".credentials.json"
    if creds and where == "file":
        write_creds(cli_dir, creds, "file")
    elif creds:
        cred_file.unlink(missing_ok=True)       # 文件优先于钥匙串，新登录留下的文件会挡住恢复的凭据
        write_creds(cli_dir, creds, "keychain")
    else:
        cred_file.unlink(missing_ok=True)
        subprocess.run(["security", "delete-generic-password", "-a", os.environ.get("USER", ""),
                        "-s", kc_service(cli_dir)], capture_output=True)
    cj = claude_json_path(cli_dir)
    d = read_json(cj, {}) or {}
    if oauth_account is None:
        d.pop("oauthAccount", None)
    else:
        d["oauthAccount"] = oauth_account
    write_json(cj, d)


def _login_has_email_flag(claude: str, env: dict) -> bool:
    """老版本的 claude auth login 没有 --email，带上会直接报错退出。"""
    try:
        r = subprocess.run([claude, "auth", "login", "--help"], capture_output=True, text=True, timeout=20, env=env)
    except Exception:
        return False
    return "--email" in (r.stdout or "") + (r.stderr or "")


def cli_login(cfg, a) -> bool:
    claude = cfg.get("claude_bin")
    if not claude:
        die("找不到 claude 命令，用 cduo config claude_bin <路径> 设置")
    cli_dir = a["cli_dir"]
    old_creds, old_where = read_creds(cli_dir)
    old_oa = (read_json(claude_json_path(cli_dir), {}) or {}).get("oauthAccount")
    env = clean_env(cfg, cli_dir)
    who = f"【{a['name']}】" + (f"（{a['email']}）" if a.get("email") else "")
    helper = private_browser_helper(cfg)
    if helper:
        env["BROWSER"] = str(helper[0])
        print(f"→ 在 {helper[1]} 的无痕窗口里打开 Claude Code 授权页，请用{who}登录。")
    else:
        print(f"→ 打开浏览器登录{who}（Claude Code 授权页）。"
              f"如果浏览器里已经登录着别的号，把授权链接复制到无痕/隐私窗口里打开。")
    argv = [claude, "auth", "login", "--claudeai"]
    if a.get("email") and _login_has_email_flag(claude, env):
        argv += ["--email", a["email"]]     # 授权页预填这个号的邮箱
    r = subprocess.run(argv, env=env)
    if r.returncode != 0:
        print("登录没有完成")
        return False
    ident = cli_identity(cli_dir)
    want = a.get("account_uuid")
    if want and ident.get("account_uuid") and ident["account_uuid"] != want:
        other = next((x["name"] for x in cfg["accounts"] if x.get("account_uuid") == ident["account_uuid"]), None)
        _undo_cli_login(cli_dir, old_creds, old_where, old_oa)
        log(f"cli login for {a['name']} got another account ({other or ident.get('email')}); undone")
        print(f"{C['red']}登录的是 {ident.get('email')}" + (f"（{lbl(cfg, other)}）" if other else "")
              + f"，不是{who}。这次登录已撤销，原来的状态没变。{C['r']}")
        return False
    a.update({k: v for k, v in ident.items() if v})
    save_config(cfg)
    log(f"cli login for {a['name']} ok")
    print(f"{C['g']}✓ CLI 已登录：{a.get('email')} · {a.get('org_name')}{C['r']}")
    return True


