def cmd_remove(args, cfg):
    """不再让 cduo 管理某个号。

    它的桌面版登录快照挪进备份目录；CLI 登录目录原样保留，以后用 cduo add 加回来不用重新授权。
    """
    a = get_account(cfg, args.name)
    if current_desktop_profile(cfg, load_state()) == a["name"] and not args.force:
        die(f"Claude 桌面版现在登录的就是 {args.name}。先切到别的号再移除（确定要移除就加 --force）")
    cfg["accounts"] = [x for x in cfg["accounts"] if x["name"] != a["name"]]
    save_config(cfg)

    def drop(st):
        st["accounts"].pop(a["name"], None)
        if st.get("desktop_current") == a["name"]:
            st.pop("desktop_current", None)
        if (st.get("recommend") or {}).get("target") == a["name"]:
            st.pop("recommend", None)
    update_state(drop)
    moved = None
    d = profile_dir(a["name"])
    if d.exists():
        moved = BACKUP / f"{dt.datetime.now():%Y%m%d-%H%M%S}-removed-{a['name']}"
        moved.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(d), str(moved))
    log(f"removed account {a['name']}" + (f" (desktop snapshot moved to {moved.name})" if moved else ""))
