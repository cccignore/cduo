def cmd_config(args, cfg):
    if not args.key:
        print(json.dumps({k: v for k, v in cfg.items() if k != "accounts"}, ensure_ascii=False, indent=1))
        return
    key, val = args.key, args.value
    if val is None:
        print(json.dumps(cfg.get(key), ensure_ascii=False))
        return
    onoff = lambda v: v.lower() in ("on", "1", "true", "yes", "开")
    if key == "active_hours":
        s, e = val.split("-")
        cfg["active_hours"] = {"start": norm_hhmm(s), "end": norm_hhmm(e)}
    elif key == "work_hours":   # 开工-收工；自动计时从开工前 4 小时开始
        s, e = (norm_hhmm(x) for x in val.split("-"))
        cfg["work_hours"] = {"start": s, "end": e}
        h, m = map(int, s.split(":"))
        cfg["active_hours"] = {"start": f"{(h - 4) % 24:02d}:{m:02d}", "end": e}
    elif key == "switch_threshold":
        cfg[key] = float(val)
    elif key == "auto_switch":
        if val not in ("off", "notify", "idle"):
            die("auto_switch 只能是 off / notify / idle")
        cfg[key] = val
    elif key in ("prewarm_enabled", "confirm_switch", "pin_org", "auto_resume"):
        cfg[key] = onoff(val)
    elif key in ("proxy", "claude_bin"):
        cfg[key] = val
    else:
        die(f"不认识的配置项 {key}")
    save_config(cfg)
    print(f"✓ {key} = {json.dumps(cfg[key], ensure_ascii=False)}")


def norm_hhmm(t: str) -> str:
    t = t.replace("：", ":").strip()
    if ":" not in t:
        t += ":00"
    hh, mm = map(int, t.split(":"))
    return f"{hh % 24:02d}:{mm:02d}"


