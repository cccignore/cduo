def _foreign_login_reset(cfg):
    def run():
        clear_desktop_login()
    _with_app_closed(cfg, run, "foreign-reset")


def main():
    ap = argparse.ArgumentParser(prog="cduo", description="多个 Claude 账号：桌面版一键切换 + 5h 窗口错峰预热")
    ap.add_argument("--version", action="version", version=VERSION)
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("status", help="看各个号的额度和建议（默认命令）")
    p.add_argument("--json", action="store_true")
    p.add_argument("--cached", action="store_true", help="只读上次的状态，不联网")
    p = sub.add_parser("switch", help="切换桌面版账号（不填名字=按规则自动选）")
    p.add_argument("name", nargs="?")
    p.add_argument("--after-turn", action="store_true", help="等当前回复结束再切")
