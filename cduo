def cmd_switch(args, cfg):
    st = load_state()
    target = args.name
    if not target:
        st = tick(cfg, allow_ping=False)
        rec = st.get("recommend") or {}
        if rec.get("action") == "switch":
            target = rec["target"]
        else:
            cur = current_desktop_profile(cfg, st)
            others = [a["name"] for a in cfg["accounts"] if a["name"] != cur and has_profile(a["name"])]
            if not others:
                die("没有可切换的另一个账号（需要先保存桌面登录快照）")
            # 号多的时候"另一个号"不止一个：和自动换号同一个规则，挑还有余量、最早刷新的那个
            target = pick_target(cfg, st, exclude=cur) or others[0]
    if (in_desktop_app() or under_claude_process()) and not args.detached:
        spawn_detached(["switch", target, "--after-turn", "--detached"] + (["--force"] if args.force else []))
        print(f"好的：等这一轮回复结束后（约十几秒），Claude 会自动重启并切到 {target}。"
              f"重启后点开原来的会话就能接着聊。")
        return
    do_switch(cfg, target, after_turn=args.after_turn, relaunch=not args.no_relaunch, force=args.force)


