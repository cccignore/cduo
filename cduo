                    else "满额，还没开始计时")
            bar = f"{col}{'█' * filled}{'░' * (10 - filled)} 已用 {eu:3.0f}%{C['r']}  {when}"
        prof = "" if has_profile(a["name"]) else f"  {C['d']}(未保存桌面登录){C['r']}"
        print(f" {mark} {(a.get('label') or a['name']):<8} {bar}{prof}")
